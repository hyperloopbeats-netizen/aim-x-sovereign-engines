        // Audio Setup
        function initAudioContext() {
            if (audioCtx) return;
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            audioAnalyser = audioCtx.createAnalyser();
            audioAnalyser.fftSize = 64;
            audioDataArray = new Uint8Array(audioAnalyser.frequencyBinCount);
        }

        function toggleSynthBeat() {
            initAudioContext();
            if (audioCtx.state === 'suspended') audioCtx.resume();

            if (isSynthPlaying) {
                stopSynthBeat();
                return;
            }

            if (audioElement) { audioElement.pause(); audioElement = null; }

            isSynthPlaying = true;
            document.getElementById('synth-btn').classList.add('bg-cyan-600/60');
            document.getElementById('matrix-status').textContent = "CYBER SYNTH BEAT ACTIVE";
            showMessage("Synthesized Cyber Beat Engaged");

            const osc1 = audioCtx.createOscillator();
            const osc2 = audioCtx.createOscillator();
            const lfo = audioCtx.createOscillator();
            const lfoGain = audioCtx.createGain();
            synthGain = audioCtx.createGain();

            osc1.type = 'sawtooth';
            osc1.frequency.setValueAtTime(55, audioCtx.currentTime);
            osc2.type = 'square';
            osc2.frequency.setValueAtTime(110, audioCtx.currentTime);
            lfo.type = 'sine';
            lfo.frequency.setValueAtTime(3.5, audioCtx.currentTime);
            lfoGain.gain.setValueAtTime(40, audioCtx.currentTime);

            lfo.connect(osc2.frequency);
            osc1.connect(synthGain);
            osc2.connect(synthGain);

            synthGain.gain.setValueAtTime(0.2, audioCtx.currentTime);
            synthGain.connect(audioAnalyser);
            audioAnalyser.connect(audioCtx.destination);

            osc1.start();
            osc2.start();
            lfo.start();
            synthOscs = [osc1, osc2, lfo];
        }

        function stopSynthBeat() {
            if (!isSynthPlaying) return;
            synthOscs.forEach(osc => { try { osc.stop(); } catch(e){} });
            synthOscs = [];
            isSynthPlaying = false;
            document.getElementById('synth-btn').classList.remove('bg-cyan-600/60');
            document.getElementById('matrix-status').textContent = "STANDBY";
            showMessage("Synth Beat Stopped");
        }

