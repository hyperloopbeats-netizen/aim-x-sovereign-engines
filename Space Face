<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HyperFace Studio Pro v8.0 - Animation & iMovie Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #030107;
            font-family: 'Inter', sans-serif;
            user-select: none;
            -webkit-user-select: none;
        }
        canvas {
            display: block;
            width: 100vw;
            height: 100vh;
        }
        /* Micro Fibre Purple Glass Design */
        .glass-purple {
            background: rgba(20, 10, 35, 0.82);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(168, 85, 247, 0.22);
            box-shadow: 0 12px 45px rgba(0, 0, 0, 0.75), inset 0 0 20px rgba(168, 85, 247, 0.08);
        }
        .glass-tab-active {
            background: rgba(147, 51, 234, 0.35);
            border-color: rgba(217, 70, 239, 0.5);
            box-shadow: 0 0 15px rgba(168, 85, 247, 0.3);
        }
        .glow-text-purple {
            text-shadow: 0 0 20px rgba(217, 70, 239, 0.7), 0 0 40px rgba(168, 85, 247, 0.4);
        }
        .scanline {
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0, 0, 0, 0.25) 50%, rgba(0, 0, 0, 0.25));
            background-size: 100% 4px;
        }
        input[type="range"] {
            accent-color: #c084fc;
        }
        ::-webkit-scrollbar {
            width: 3px;
            height: 3px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.2);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(168, 85, 247, 0.4);
            border-radius: 3px;
        }
        .keyframe-marker {
            position: absolute;
            width: 8px;
            height: 8px;
            background: #e879f9;
            transform: rotate(45deg) translate(-50%, -50%);
            top: 50%;
            cursor: pointer;
            box-shadow: 0 0 8px #e879f9;
            transition: transform 0.1s;
        }
        .keyframe-marker:hover {
            transform: rotate(45deg) scale(1.6) translate(-35%, -35%);
            background: #38bdf8;
        }
    </style>
</head>
<body class="text-white relative">

    <!-- CRT Scanline & Vignette Overlay -->
    <div class="absolute inset-0 scanline pointer-events-none z-20 opacity-20"></div>
    <div class="absolute inset-0 bg-radial pointer-events-none z-10" style="background: radial-gradient(circle at center, transparent 35%, rgba(3,1,7,0.95) 100%);"></div>

    <!-- WebGL Canvas Container -->
    <div id="canvas-container" class="absolute inset-0 z-0"></div>

    <!-- Micro Fibre Purple Glass HUD UI -->
    <div class="absolute inset-0 z-30 pointer-events-none flex flex-col justify-between p-3 md:p-5">
        
        <!-- TOP APP BAR -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2.5 pointer-events-auto">
            
            <!-- Branding -->
            <div class="glass-purple px-4 py-2.5 rounded-2xl flex items-center space-x-3 shadow-2xl">
                <div class="w-2.5 h-2.5 rounded-full bg-purple-400 animate-ping"></div>
                <div>
                    <h1 class="font-black tracking-widest text-xs md:text-sm bg-gradient-to-r from-purple-300 via-fuchsia-300 to-cyan-300 bg-clip-text text-transparent">
                        HYPERFACE STUDIO PRO // v8.0
                    </h1>
                    <p class="text-[9px] font-mono text-purple-300/70 tracking-wider">ANIMATION SUITE • IMOVIE EDITOR • 4-TRACK TIMELINE</p>
                </div>
            </div>

            <!-- Micro Tabs Navigation -->
            <div class="glass-purple px-2.5 py-1.5 rounded-2xl flex flex-wrap items-center gap-1.5 shadow-2xl font-mono text-xs">
                <button class="nav-tab px-3 py-1.5 rounded-xl glass-tab-active transition text-purple-200 cursor-pointer" data-target="panel-scene">🔮 SCENE</button>
                <button class="nav-tab px-3 py-1.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/60 border border-purple-500/20 transition text-purple-200 cursor-pointer" data-target="panel-ai">🤖 AI MODULATOR</button>
                <button class="nav-tab px-3 py-1.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/60 border border-purple-500/20 transition text-purple-200 cursor-pointer" data-target="panel-lighting">💡 LIGHTS</button>
                <button class="nav-tab px-3 py-1.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/60 border border-purple-500/20 transition text-purple-200 cursor-pointer" data-target="panel-audio">🎵 AUDIO</button>
                <button class="nav-tab px-3 py-1.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/60 border border-purple-500/20 transition text-fuchsia-200 cursor-pointer" data-target="panel-imovie">🎬 IMOVIE</button>
                <button class="nav-tab px-3 py-1.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/60 border border-purple-500/20 transition text-cyan-200 cursor-pointer" data-target="panel-particles">✨ PARTICLES</button>
                <button class="nav-tab px-3 py-1.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/60 border border-purple-500/20 transition text-amber-200 cursor-pointer" data-target="panel-camera">📷 CAMERA</button>
                <button id="btn-snapshot" class="px-3 py-1.5 rounded-xl bg-fuchsia-900/40 hover:bg-fuchsia-900/60 border border-fuchsia-500/30 transition text-fuchsia-200 cursor-pointer">📸 SNAP</button>
                <button id="btn-record" class="px-3 py-1.5 rounded-xl bg-red-950/40 hover:bg-red-900/60 border border-red-500/30 transition text-red-200 cursor-pointer flex items-center space-x-1.5">
                    <span id="record-dot" class="w-2 h-2 rounded-full bg-red-500"></span>
                    <span id="record-text">REC</span>
                </button>
            </div>
        </header>

        <!-- FLOATING CONTROL PANELS (SWITCHED VIA MICRO TABS) -->
        <div class="flex-1 flex justify-start items-start pointer-events-none my-2">
            
            <!-- PANEL 1: SCENE & MESH INSPECTOR -->
            <div id="panel-scene" class="glass-purple w-72 md:w-80 rounded-3xl p-4 pointer-events-auto transition-all duration-300 shadow-2xl space-y-3">
                <div class="flex justify-between items-center pb-2 border-b border-purple-500/20">
                    <h3 class="text-xs font-black tracking-wider text-purple-200 font-mono">🔮 MODULE 1: SCENE & MESH</h3>
                    <button class="text-purple-400 hover:text-white text-xs cursor-pointer" onclick="togglePanel('panel-scene')">✕</button>
                </div>

                <div>
                    <label class="text-[9px] text-purple-300/70 font-mono block mb-1">3D CYBER MESH ASSET</label>
                    <select id="asset-select" class="w-full bg-black/50 border border-purple-500/30 rounded-xl p-2 text-xs text-purple-100 font-bold focus:outline-none cursor-pointer">
                        <option value="face">Cyber Sovereign Face</option>
                        <option value="skull">Cybernetic Skull</option>
                        <option value="mech">Mech Droid Core</option>
                        <option value="crystal">Monolith Crystal</option>
                        <option value="torso">Cybernetic Torso</option>
                    </select>
                </div>

                <div>
                    <label class="text-[9px] text-purple-300/70 font-mono block mb-1">MODULE 2: GLSL SUB-SURFACE SKIN</label>
                    <select id="skin-select" class="w-full bg-black/50 border border-purple-500/30 rounded-xl p-2 text-xs text-fuchsia-200 font-bold focus:outline-none cursor-pointer">
                        <option value="0">Obsidian Chrome</option>
                        <option value="1">Neon Matrix Wire</option>
                        <option value="2">Spartan Amethyst Crystal</option>
                        <option value="3">Liquid Hologram Glass</option>
                    </select>
                </div>

                <div class="space-y-2 pt-2 border-t border-purple-500/15">
                    <span class="text-[9px] text-purple-300/70 font-mono block">TRANSFORM INSPECTOR</span>
                    <div class="grid grid-cols-3 gap-1.5 text-[9px] font-mono">
                        <div>
                            <span class="text-purple-400/60">POS X</span>
                            <input type="number" id="prop-pos-x" step="0.1" value="0" class="w-full bg-black/50 border border-purple-500/25 rounded p-1 text-center text-purple-200">
                        </div>
                        <div>
                            <span class="text-purple-400/60">POS Y</span>
                            <input type="number" id="prop-pos-y" step="0.1" value="0" class="w-full bg-black/50 border border-purple-500/25 rounded p-1 text-center text-purple-200">
                        </div>
                        <div>
                            <span class="text-purple-400/60">POS Z</span>
                            <input type="number" id="prop-pos-z" step="0.1" value="0" class="w-full bg-black/50 border border-purple-500/25 rounded p-1 text-center text-purple-200">
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-1.5 text-[9px] font-mono">
                        <div>
                            <span class="text-purple-400/60">ROT X</span>
                            <input type="number" id="prop-rot-x" step="5" value="0" class="w-full bg-black/50 border border-purple-500/25 rounded p-1 text-center text-fuchsia-200">
                        </div>
                        <div>
                            <span class="text-purple-400/60">ROT Y</span>
                            <input type="number" id="prop-rot-y" step="5" value="0" class="w-full bg-black/50 border border-purple-500/25 rounded p-1 text-center text-fuchsia-200">
                        </div>
                        <div>
                            <span class="text-purple-400/60">SCALE</span>
                            <input type="number" id="prop-scale" step="0.1" value="1.0" class="w-full bg-black/50 border border-purple-500/25 rounded p-1 text-center text-cyan-200">
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL 2: SYNTHETIC AI PROMPT MODULATOR (MODULE 6) -->
            <div id="panel-ai" class="glass-purple w-72 md:w-80 rounded-3xl p-4 pointer-events-auto transition-all duration-300 shadow-2xl space-y-3 hidden">
                <div class="flex justify-between items-center pb-2 border-b border-purple-500/20">
                    <h3 class="text-xs font-black tracking-wider text-purple-200 font-mono">🤖 MODULE 6: SYNTHETIC AI MODULATOR</h3>
                    <button class="text-purple-400 hover:text-white text-xs cursor-pointer" onclick="togglePanel('panel-ai')">✕</button>
                </div>

                <div class="space-y-2.5">
                    <label class="text-[9px] text-purple-300/70 font-mono block">PROMPT 3D GEOMETRY / TEXTURE</label>
                    <textarea id="ai-prompt-input" rows="3" placeholder="e.g., Cyberpunk crystal obsidian skull with neon fuchsia ripples..." class="w-full bg-black/50 border border-purple-500/30 rounded-xl p-2.5 text-xs text-purple-100 font-mono focus:outline-none resize-none">Cyberpunk crystal obsidian sovereign face with quantum neon pulse</textarea>
                    
                    <div class="grid grid-cols-2 gap-2">
                        <button id="ai-generate-mesh" class="py-2 rounded-xl bg-purple-900/60 hover:bg-purple-900 border border-purple-500/40 text-[10px] font-bold text-purple-200 cursor-pointer shadow-lg">
                            🔮 SYNTHESIZE MESH
                        </button>
                        <button id="ai-generate-shader" class="py-2 rounded-xl bg-fuchsia-900/60 hover:bg-fuchsia-900 border border-fuchsia-500/40 text-[10px] font-bold text-fuchsia-200 cursor-pointer shadow-lg">
                            ✨ SYNTHESIZE SHADER
                        </button>
                    </div>

                    <div id="ai-status" class="text-[9px] text-cyan-300 font-mono bg-black/40 p-2 rounded-xl border border-purple-500/20 text-center">
                        AI MODULATOR READY
                    </div>
                </div>
            </div>

            <!-- PANEL 3: LIGHTING DIRECTOR (MODULE 4) -->
            <div id="panel-lighting" class="glass-purple w-72 md:w-80 rounded-3xl p-4 pointer-events-auto transition-all duration-300 shadow-2xl space-y-3 hidden">
                <div class="flex justify-between items-center pb-2 border-b border-purple-500/20">
                    <h3 class="text-xs font-black tracking-wider text-fuchsia-200 font-mono">💡 MODULE 4: LIGHTING DIRECTOR</h3>
                    <button class="text-purple-400 hover:text-white text-xs cursor-pointer" onclick="togglePanel('panel-lighting')">✕</button>
                </div>

                <div class="space-y-3">
                    <div>
                        <div class="flex justify-between text-[9px] font-mono text-purple-200 mb-1">
                            <span>CYAN KEY LIGHT INTENSITY</span>
                            <span id="val-light-cyan">6.0</span>
                        </div>
                        <input type="range" id="slider-light-cyan" min="0" max="20" step="0.5" value="6" class="w-full cursor-pointer">
                    </div>
                    <div>
                        <div class="flex justify-between text-[9px] font-mono text-fuchsia-200 mb-1">
                            <span>FUCHSIA FILL LIGHT INTENSITY</span>
                            <span id="val-light-fuchsia">6.0</span>
                        </div>
                        <input type="range" id="slider-light-fuchsia" min="0" max="20" step="0.5" value="6" class="w-full cursor-pointer">
                    </div>
                    <div>
                        <div class="flex justify-between text-[9px] font-mono text-cyan-200 mb-1">
                            <span>CYBER GLOW RIM INTENSITY</span>
                            <span id="val-light-rim">4.0</span>
                        </div>
                        <input type="range" id="slider-light-rim" min="0" max="15" step="0.5" value="4" class="w-full cursor-pointer">
                    </div>
                </div>
            </div>

            <!-- PANEL 4: AUDIO & FFT REACTIVITY (MODULE 1 & 9) -->
            <div id="panel-audio" class="glass-purple w-72 md:w-80 rounded-3xl p-4 pointer-events-auto transition-all duration-300 shadow-2xl space-y-3 hidden">
                <div class="flex justify-between items-center pb-2 border-b border-purple-500/20">
                    <h3 class="text-xs font-black tracking-wider text-cyan-200 font-mono">🎵 MODULE 1 & 9: AUDIO RIG</h3>
                    <button class="text-purple-400 hover:text-white text-xs cursor-pointer" onclick="togglePanel('panel-audio')">✕</button>
                </div>

                <div class="space-y-3">
                    <div class="flex gap-2">
                        <label class="flex-1 py-2 px-3 rounded-xl bg-purple-900/40 hover:bg-purple-900/60 border border-purple-500/30 text-xs font-bold text-purple-200 text-center cursor-pointer flex items-center justify-center space-x-1.5 shadow-md">
                            <span>🎵 LOAD MP3</span>
                            <input type="file" id="audio-upload" accept="audio/mp3,audio/*" class="hidden">
                        </label>
                        <button id="btn-play-audio" class="px-4 py-2 rounded-xl bg-fuchsia-900/40 hover:bg-fuchsia-900/60 border border-fuchsia-500/30 text-xs font-bold text-fuchsia-200 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" disabled>
                            ▶ PLAY
                        </button>
                    </div>

                    <button id="synth-btn" class="w-full py-2.5 rounded-xl text-xs font-bold bg-cyan-600/30 hover:bg-cyan-600/50 transition border border-cyan-500/40 cursor-pointer shadow-lg text-cyan-200">
                        ⚡ GENERATE CYBER SYNTH BEAT
                    </button>

                    <div>
                        <div class="flex justify-between text-[9px] font-mono text-purple-200 mb-1">
                            <span>FFT SENSITIVITY</span>
                            <span id="val-sensitivity">1.6</span>
                        </div>
                        <input type="range" id="slider-sensitivity" min="0.2" max="4.0" step="0.1" value="1.6" class="w-full cursor-pointer">
                    </div>

                    <div class="text-[9px] text-purple-300/80 font-mono bg-black/50 p-2.5 rounded-xl border border-purple-500/20 text-center truncate">
                        STATUS: <span id="matrix-status" class="text-fuchsia-300 font-bold">STANDBY (SILENT)</span>
                    </div>
                </div>
            </div>

            <!-- PANEL 5: IMOVIE VIDEO EDITOR SUITE (MODULE 3) -->
            <div id="panel-imovie" class="glass-purple w-80 md:w-96 rounded-3xl p-4 pointer-events-auto transition-all duration-300 shadow-2xl space-y-3 hidden">
                <div class="flex justify-between items-center pb-2 border-b border-purple-500/20">
                    <h3 class="text-xs font-black tracking-wider text-fuchsia-300 font-mono">🎬 MODULE 3: IMOVIE MULTI-CLIP SUITE</h3>
                    <button class="text-purple-400 hover:text-white text-xs cursor-pointer" onclick="togglePanel('panel-imovie')">✕</button>
                </div>

                <div class="space-y-2.5">
                    <div class="flex justify-between items-center">
                        <span class="text-[9px] font-mono text-purple-300/80">CLIP SEQUENCER & TRANSITIONS</span>
                        <button id="imovie-add-clip" class="px-2.5 py-1 rounded-lg bg-fuchsia-900/50 hover:bg-fuchsia-900/80 border border-fuchsia-500/30 text-[10px] font-bold text-fuchsia-200 cursor-pointer">+ ADD CLIP</button>
                    </div>

                    <div id="imovie-clips-container" class="space-y-1.5 max-h-36 overflow-y-auto pr-1">
                        <!-- Dynamic clip rows populated via JS -->
                    </div>

                    <div class="pt-2 border-t border-purple-500/20 space-y-2">
                        <span class="text-[9px] font-mono text-purple-300/80">TITLE & SUBTITLE OVERLAYS</span>
                        <input type="text" id="imovie-title-input" placeholder="Enter cinematic subtitle..." value="CYBER SOVEREIGN 3D" class="w-full bg-black/50 border border-purple-500/30 rounded-xl px-3 py-1.5 text-xs text-purple-100 font-bold">
                        <div class="flex gap-2">
                            <select id="imovie-transition-select" class="flex-1 bg-black/50 border border-purple-500/30 rounded-xl p-1.5 text-[10px] text-purple-200 font-bold cursor-pointer">
                                <option value="fade">Transition: Fade / Dissolve</option>
                                <option value="glitch">Transition: Cyber Glitch</option>
                                <option value="zoom">Transition: Quantum Zoom</option>
                            </select>
                            <button id="imovie-apply-title" class="px-3 py-1.5 rounded-xl bg-purple-900/60 hover:bg-purple-900 border border-purple-500/30 text-[10px] font-bold text-purple-200 cursor-pointer">APPLY</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL 6: PARTICLES & FX MODULE -->
            <div id="panel-particles" class="glass-purple w-72 md:w-80 rounded-3xl p-4 pointer-events-auto transition-all duration-300 shadow-2xl space-y-3 hidden">
                <div class="flex justify-between items-center pb-2 border-b border-purple-500/20">
                    <h3 class="text-xs font-black tracking-wider text-cyan-200 font-mono">✨ PARTICLE SPARK CLOUD</h3>
                    <button class="text-purple-400 hover:text-white text-xs cursor-pointer" onclick="togglePanel('panel-particles')">✕</button>
                </div>

                <div class="space-y-3">
                    <div>
                        <div class="flex justify-between text-[9px] font-mono text-purple-200 mb-1">
                            <span>PARTICLE COUNT</span>
                            <span id="val-particle-count">500</span>
                        </div>
                        <input type="range" id="slider-particle-count" min="100" max="2000" step="100" value="500" class="w-full cursor-pointer">
                    </div>
                    <div>
                        <div class="flex justify-between text-[9px] font-mono text-cyan-200 mb-1">
                            <span>PARTICLE ORBIT SPEED</span>
                            <span id="val-particle-speed">1.0</span>
                        </div>
                        <input type="range" id="slider-particle-speed" min="0.1" max="4.0" step="0.1" value="1.0" class="w-full cursor-pointer">
                    </div>
                </div>
            </div>

            <!-- PANEL 7: CAMERA & POST-FX MODULE -->
            <div id="panel-camera" class="glass-purple w-72 md:w-80 rounded-3xl p-4 pointer-events-auto transition-all duration-300 shadow-2xl space-y-3 hidden">
                <div class="flex justify-between items-center pb-2 border-b border-purple-500/20">
                    <h3 class="text-xs font-black tracking-wider text-amber-200 font-mono">📷 CAMERA & TONEMAPPING</h3>
                    <button class="text-purple-400 hover:text-white text-xs cursor-pointer" onclick="togglePanel('panel-camera')">✕</button>
                </div>

                <div class="space-y-3">
                    <div>
                        <div class="flex justify-between text-[9px] font-mono text-purple-200 mb-1">
                            <span>EXPOSURE</span>
                            <span id="val-exposure">1.3</span>
                        </div>
                        <input type="range" id="slider-exposure" min="0.5" max="3.0" step="0.1" value="1.3" class="w-full cursor-pointer">
                    </div>
                    <div>
                        <div class="flex justify-between text-[9px] font-mono text-amber-200 mb-1">
                            <span>FOV (FIELD OF VIEW)</span>
                            <span id="val-fov">60</span>
                        </div>
                        <input type="range" id="slider-fov" min="30" max="100" step="5" value="60" class="w-full cursor-pointer">
                    </div>
                </div>
            </div>

        </div>

        <!-- BOTTOM EXPANDED 4-TRACK TIMELINE SUITE (MODULE 2) -->
        <footer class="glass-purple rounded-3xl p-3 flex flex-col gap-2.5 pointer-events-auto shadow-2xl">
            
            <!-- Transport Bar -->
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-purple-500/20 pb-2.5">
                <div class="flex items-center space-x-1.5">
                    <button id="tl-play" class="px-3 py-1.5 rounded-xl bg-purple-900/50 hover:bg-purple-900/80 border border-purple-500/30 text-xs font-bold text-purple-200 cursor-pointer">
                        ▶ PLAY
                    </button>
                    <button id="tl-stop" class="px-3 py-1.5 rounded-xl bg-black/40 hover:bg-purple-950/50 border border-purple-500/20 text-xs font-bold text-purple-300 cursor-pointer">
                        ⏹ STOP
                    </button>
                    <button id="tl-loop" class="px-3 py-1.5 rounded-xl bg-purple-950/60 hover:bg-purple-900/80 border border-purple-500/30 text-xs font-bold text-purple-200 cursor-pointer">
                        🔁 LOOP: ON
                    </button>
                    <button id="tl-add-key" class="px-3 py-1.5 rounded-xl bg-fuchsia-900/50 hover:bg-fuchsia-900/80 border border-fuchsia-500/30 text-xs font-bold text-fuchsia-200 cursor-pointer">
                        ➕ ADD KEYFRAME
                    </button>
                </div>

                <div class="font-mono text-xs bg-black/40 px-3 py-1 rounded-xl border border-purple-500/20 text-purple-300">
                    TIME: <span id="timecode-display" class="font-bold text-fuchsia-300">0.00s</span> / <span id="duration-display">10.00s</span>
                </div>

                <div class="flex items-center space-x-3">
                    <div class="hidden sm:flex items-end space-x-1 h-5 w-28 justify-around" id="spectrum-bars"></div>
                    <span class="font-mono text-xs text-purple-300/70">FPS: <span id="fps-display" class="text-purple-200">60</span></span>
                </div>
            </div>

            <!-- 4 Simultaneous Tracks Scrubbing Area -->
            <div class="relative h-24 bg-black/60 rounded-2xl border border-purple-500/20 overflow-hidden flex flex-col justify-between p-2">
                <div class="absolute inset-x-3 top-1 h-3 flex justify-between text-[9px] font-mono text-purple-400/50 pointer-events-none">
