        function loadAsset(type) {
            if (activeMesh) scene.remove(activeMesh);

            let geometry;
            if (type === 'face') {
                geometry = new THREE.IcosahedronGeometry(1.6, 5);
                const posAttr = geometry.attributes.position;
                for (let i = 0; i < posAttr.count; i++) {
                    let x = posAttr.getX(i), y = posAttr.getY(i), z = posAttr.getZ(i);
                    if (z > 0) {
                        if (y > 0.4) { z += 0.22; x *= 0.9; }
                        if (Math.hypot(x - 0.45, y - 0.25) < 0.5 || Math.hypot(x + 0.45, y - 0.25) < 0.5) { z -= 0.4; }
                        if (Math.abs(x) < 0.3 && y > -0.5 && y < 0.4) { z += Math.max(0, 0.68 - Math.abs(x) * 2.0); }
                    }
                    posAttr.setXYZ(i, x, y, z);
                }
                geometry.computeVertexNormals();
            } else if (type === 'skull') {
                geometry = new THREE.SphereGeometry(1.5, 32, 32);
                const posAttr = geometry.attributes.position;
                for (let i = 0; i < posAttr.count; i++) {
                    let x = posAttr.getX(i), y = posAttr.getY(i), z = posAttr.getZ(i);
                    if (y < -0.2 && z > 0) { z *= 0.6; x *= 0.8; }
                    if (y > 0.2 && z > 0 && Math.abs(x) < 0.5) { z += 0.3; }
                    posAttr.setXYZ(i, x, y, z);
                }
                geometry.computeVertexNormals();
            } else if (type === 'mech') {
                geometry = new THREE.BoxGeometry(2, 2, 2, 8, 8, 8);
            } else if (type === 'crystal') {
                geometry = new THREE.ConeGeometry(1.4, 3.2, 6);
            } else {
                geometry = new THREE.CylinderGeometry(1.0, 1.4, 2.2, 16);
            }

            customMaterial = new THREE.ShaderMaterial({
                vertexShader: document.getElementById('vertexShader').textContent,
                fragmentShader: document.getElementById('fragmentShader').textContent,
                uniforms: {
                    uTime: { value: 0.0 },
                    uSubBass: { value: 0.0 },
                    uMidLip: { value: 0.0 },
                    uHighSparks: { value: 0.0 },
                    uRipplePos: { value: new THREE.Vector3(0, 0, 0) },
                    uRippleTime: { value: -1.0 },
                    uSkinMode: { value: parseInt(document.getElementById('skin-select').value) },
                    uAIModulation: { value: 0.0 }
                },
                side: THREE.DoubleSide
            });

            activeMesh = new THREE.Mesh(geometry, customMaterial);
            scene.add(activeMesh);
            showMessage(`Loaded Asset: ${type.toUpperCase()}`);
        }

        function createCyberParticles(count) {
            if (particleSystem) scene.remove(particleSystem);
            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(count * 3);
            for (let i = 0; i < count * 3; i += 3) {
                positions[i] = (Math.random() - 0.5) * 12;
                positions[i+1] = (Math.random() - 0.5) * 12;
                positions[i+2] = (Math.random() - 0.5) * 12;
            }
            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const pMat = new THREE.PointsMaterial({ size: 0.055, color: 0xc084fc, transparent: true, opacity: 0.8, blending: THREE.AdditiveBlending });
            particleSystem = new THREE.Points(geometry, pMat);
            scene.add(particleSystem);
        }

        // Keyframe Interpolation for 4 Tracks
        function evaluateKeyframes(trackName, time) {
            const track = keyframes[trackName];
            if (!track || track.length === 0) return 0;
            if (time <= track[0].time) return track[0].value;
            if (time >= track[track.length - 1].time) return track[track.length - 1].value;

            for (let i = 0; i < track.length - 1; i++) {
                if (time >= track[i].time && time <= track[i+1].time) {
                    const t0 = track[i].time, v0 = track[i].value;
                    const t1 = track[i+1].time, v1 = track[i+1].value;
                    const alpha = (time - t0) / (t1 - t0);
                    return v0 + (v1 - v0) * alpha;
                }
            }
            return 0;
        }

        function renderKeyframeMarkers() {
            document.querySelectorAll('.keyframe-marker').forEach(el => el.remove());
            ['posY', 'rotY', 'scale', 'fx'].forEach(trackName => {
                const row = document.querySelector(`.track-row[data-track="${trackName}"]`);
                if (!row) return;
                keyframes[trackName].forEach(kf => {
                    const marker = document.createElement('div');
                    marker.className = 'keyframe-marker';
                    marker.style.left = `${(kf.time / duration) * 100}%`;
                    row.appendChild(marker);
                });
            });
        }

