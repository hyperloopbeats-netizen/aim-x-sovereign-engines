                createCyberParticles(count);
            });
            document.getElementById('slider-exposure').addEventListener('input', (e) => {
                renderer.toneMappingExposure = parseFloat(e.target.value);
                document.getElementById('val-exposure').textContent = e.target.value;
            });
            document.getElementById('slider-fov').addEventListener('input', (e) => {
                camera.fov = parseInt(e.target.value);
                camera.updateProjectionMatrix();
                document.getElementById('val-fov').textContent = e.target.value;
            });

            // Audio & MP3 Upload
            document.getElementById('synth-btn').addEventListener('click', toggleSynthBeat);
            document.getElementById('audio-upload').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) return;
                if (isSynthPlaying) stopSynthBeat();
                initAudioContext();
                if (audioCtx.state === 'suspended') audioCtx.resume();

                const reader = new FileReader();
                reader.onload = function(evt) {
                    audioCtx.decodeAudioData(evt.target.result, function(buffer) {
                        if (audioSource) { try { audioSource.disconnect(); } catch(err){} }
                        const sourceNode = audioCtx.createBufferSource();
                        sourceNode.buffer = buffer;
                        sourceNode.loop = true;
                        sourceNode.connect(audioAnalyser);
                        audioAnalyser.connect(audioCtx.destination);
                        window.currentAudioBufferSource = sourceNode;
                        document.getElementById('btn-play-audio').removeAttribute('disabled');
                        document.getElementById('matrix-status').textContent = `LOADED: ${file.name.substring(0, 14)}`;
                        showMessage(`MP3 Loaded: ${file.name}`);
                    });
                };
                reader.readAsArrayBuffer(file);
            });

            document.getElementById('btn-play-audio').addEventListener('click', () => {
                initAudioContext();
                if (audioCtx.state === 'suspended') audioCtx.resume();
                if (isAudioPlaying) {
                    if (window.currentAudioBufferSource) { try { window.currentAudioBufferSource.stop(); } catch(e){} }
                    isAudioPlaying = false;
                    document.getElementById('btn-play-audio').textContent = "▶ PLAY";
                } else {
                    const fileInput = document.getElementById('audio-upload');
                    if (fileInput.files.length > 0) {
                        const file = fileInput.files[0];
                        const reader = new FileReader();
                        reader.onload = function(evt) {
                            audioCtx.decodeAudioData(evt.target.result, function(buffer) {
                                const sourceNode = audioCtx.createBufferSource();
                                sourceNode.buffer = buffer;
                                sourceNode.loop = true;
                                sourceNode.connect(audioAnalyser);
                                audioAnalyser.connect(audioCtx.destination);
                                sourceNode.start(0);
                                window.currentAudioBufferSource = sourceNode;
                                isAudioPlaying = true;
                                document.getElementById('btn-play-audio').textContent = "⏸ PAUSE";
                                showMessage("Playing MP3 Audio Stream");
                            });
                        };
                        reader.readAsArrayBuffer(file);
                    }
                }
            });

            // iMovie Suite Actions
            document.getElementById('imovie-add-clip').addEventListener('click', () => {
                const newClip = { id: Date.now(), name: `Cyber Cinematic Clip #${iMovieClips.length + 1}`, duration: 3.5, transition: 'fade' };
                iMovieClips.push(newClip);
                renderIMovieClips();
                showMessage("Added New iMovie Sequence Clip");
            });

            document.getElementById('imovie-apply-title').addEventListener('click', () => {
                const text = document.getElementById('imovie-title-input').value;
                showMessage(`Applied Subtitle: "${text}"`);
            });

            // Timeline Transport
            document.getElementById('tl-play').addEventListener('click', () => {
                isPlaying = !isPlaying;
                document.getElementById('tl-play').textContent = isPlaying ? "⏸ PAUSE" : "▶ PLAY";
            });
            document.getElementById('tl-stop').addEventListener('click', () => {
                isPlaying = false;
                currentTime = 0;
                document.getElementById('tl-play').textContent = "▶ PLAY";
            });
            document.getElementById('tl-loop').addEventListener('click', () => {
                isLooping = !isLooping;
                document.getElementById('tl-loop').textContent = `🔁 LOOP: ${isLooping ? 'ON' : 'OFF'}`;
            });

            document.getElementById('tl-add-key').addEventListener('click', () => {
                const posYVal = parseFloat(document.getElementById('prop-pos-y').value) || 0;
                const rotYVal = parseFloat(document.getElementById('prop-rot-y').value) * (Math.PI/180) || 0;
                const scaleVal = parseFloat(document.getElementById('prop-scale').value) || 1.0;
                
                const t = parseFloat(currentTime.toFixed(2));
                keyframes.posY.push({ time: t, value: posYVal });
                keyframes.rotY.push({ time: t, value: rotYVal });
                keyframes.scale.push({ time: t, value: scaleVal });

                ['posY', 'rotY', 'scale', 'fx'].forEach(k => keyframes[k].sort((a,b) => a.time - b.time));
                renderKeyframeMarkers();
                showMessage(`Added Keyframes across all tracks at ${t}s`);
            });

            // Timeline Scrubber Click
            const trackArea = document.getElementById('timeline-tracks-area');
            trackArea.addEventListener('click', (e) => {
                const rect = trackArea.getBoundingClientRect();
                const pct = (e.clientX - rect.left) / rect.width;
                currentTime = Math.max(0, Math.min(duration, pct * duration));
            });

            // Snapshot export
            document.getElementById('btn-snapshot').addEventListener('click', () => {
                renderer.render(scene, camera);
                const dataURL = renderer.domElement.toDataURL('image/png');
                const link = document.createElement('a');
                link.download = 'HyperFace_Studio_Snapshot.png';
                link.href = dataURL;
                link.click();
                showMessage("Exported HD PNG Snapshot");
            });

            // WebM Video Recording
            let mediaRecorder, recordedChunks = [];
            document.getElementById('btn-record').addEventListener('click', () => {
                if (mediaRecorder && mediaRecorder.state === 'recording') {
                    mediaRecorder.stop();
                    document.getElementById('record-dot').classList.remove('bg-green-500', 'animate-ping');
                    document.getElementById('record-dot').classList.add('bg-red-500');
                    document.getElementById('record-text').textContent = "REC";
                    showMessage("Recording Completed & Downloaded");
                    return;
                }
                try {
                    const stream = renderer.domElement.captureStream(30);
                    mediaRecorder = new MediaRecorder(stream, { mimeType: 'video/webm;codecs=vp9' });
                    recordedChunks = [];
                    mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) recordedChunks.push(e.data); };
                    mediaRecorder.onstop = () => {
                        const blob = new Blob(recordedChunks, { type: 'video/webm' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url; a.download = 'HyperFace_Animation_Studio.webm'; a.click();
                    };
                    mediaRecorder.start();
                    document.getElementById('record-dot').classList.remove('bg-red-500');
                    document.getElementById('record-dot').classList.add('bg-green-500', 'animate-ping');
                    document.getElementById('record-text').textContent = "REC...";
                    showMessage("WebM Animation Recording Started");
                } catch(err) {
                    showMessage("MediaRecorder not supported in this browser.");
                }
            });

            renderKeyframeMarkers();
        }

        // Main Animation & Render Loop
        let frameCount = 0, lastTime = performance.now();

        function animate() {
            requestAnimationFrame(animate);

            const delta = clock.getDelta();
            const elapsedTime = clock.getElapsedTime();

            if (aiModulationValue > 0) {
                aiModulationValue -= delta * 0.5;
                if (aiModulationValue < 0) aiModulationValue = 0;
            }

            frameCount++;
            const now = performance.now();
            if (now - lastTime >= 1000) {
                document.getElementById('fps-display').textContent = frameCount;
                frameCount = 0; lastTime = now;
            }

            controls.update();

            if (isPlaying) {
                currentTime += delta;
                if (currentTime >= duration) {
                    if (isLooping) currentTime = 0;
                    else { currentTime = duration; isPlaying = false; document.getElementById('tl-play').textContent = "▶ PLAY"; }
                }
            }

            document.getElementById('timecode-display').textContent = currentTime.toFixed(2) + 's';
            document.getElementById('duration-display').textContent = duration.toFixed(2) + 's';
            document.getElementById('timeline-playhead').style.left = `${(currentTime / duration) * 100}%`;

            // Evaluate 4 tracks
            const evalPosY = evaluateKeyframes('posY', currentTime);
            const evalRotY = evaluateKeyframes('rotY', currentTime);
            const evalScale = evaluateKeyframes('scale', currentTime);
            const evalFx = evaluateKeyframes('fx', currentTime);

            if (activeMesh) {
                activeMesh.position.y = evalPosY;
                activeMesh.rotation.y = evalRotY;
                activeMesh.scale.set(evalScale, evalScale, evalScale);

                if (isPlaying) {
                    document.getElementById('prop-pos-y').value = evalPosY.toFixed(2);
                    document.getElementById('prop-rot-y').value = (evalRotY * (180/Math.PI)).toFixed(0);
                    document.getElementById('prop-scale').value = evalScale.toFixed(2);
                }
            }

            // Audio FFT analysis
            let subBass = 0, midLip = 0, highSparks = 0;
            if (audioAnalyser && (isAudioPlaying || isSynthPlaying)) {
                audioAnalyser.getByteFrequencyData(audioDataArray);
                let subSum = 0; for (let i = 0; i < 4; i++) subSum += audioDataArray[i];
                subBass = (subSum / 4) / 255.0;
                let midSum = 0; for (let i = 4; i < 13; i++) midSum += audioDataArray[i];
                midLip = (midSum / 9) / 255.0;
                let highSum = 0; for (let i = 13; i < 32; i++) highSum += audioDataArray[i];
                highSparks = (highSum / 19) / 255.0;

                for (let i = 0; i < numBars; i++) {
                    const val = audioDataArray[i * 2] / 255.0;
                    barElements[i].style.height = `${Math.max(10, val * 100)}%`;
                }
            } else {
                subBass = (Math.sin(elapsedTime * 3) * 0.5 + 0.5) * (0.08 + evalFx * 0.1);
                midLip = (Math.cos(elapsedTime * 2.5) * 0.5 + 0.5) * (0.08 + evalFx * 0.1);
                highSparks = 0.05 + evalFx * 0.15;
                for (let i = 0; i < numBars; i++) {
                    barElements[i].style.height = `${Math.sin(elapsedTime * 4 + i * 0.3) * 20 + 30}%`;
                }
            }

            if (customMaterial) {
                customMaterial.uniforms.uTime.value = elapsedTime;
                customMaterial.uniforms.uSubBass.value = subBass * sensitivity;
                customMaterial.uniforms.uMidLip.value = midLip * sensitivity * 1.5;
                customMaterial.uniforms.uHighSparks.value = highSparks * sensitivity;
                customMaterial.uniforms.uAIModulation.value = aiModulationValue;
            }

            renderer.render(scene, camera);
        }

        window.onload = function() {
            initThree();
            animate();
        };
    </script>
</body>
</html>
