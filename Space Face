    <!-- GLSL Vertex Shader -->
    <script id="vertexShader" type="x-shader/x-vertex">
        uniform float uTime;
        uniform float uSubBass;
        uniform float uMidLip;
        uniform float uHighSparks;
        uniform vec3 uRipplePos;
        uniform float uRippleTime;
        uniform float uAIModulation;

        varying vec3 vNormal;
        varying vec3 vPosition;
        varying vec2 vUv;
        varying float vDisplacement;

        void main() {
            vUv = uv;
            vNormal = normal;
            vec3 pos = position;

            if (pos.y < -0.2) {
                pos.y -= (uSubBass + uAIModulation * 0.2) * 0.45 * (1.0 - abs(pos.x) * 0.5);
                pos.z += (uSubBass + uAIModulation * 0.2) * 0.3;
            }

            float distToMouth = length(pos.xy - vec2(0.0, -0.38));
            if (distToMouth < 0.55 && pos.z > 0.25) {
                if (pos.y > -0.38) {
                    pos.y += (uMidLip + uAIModulation * 0.15) * 0.55;
                    pos.z += (uMidLip + uAIModulation * 0.15) * 0.4;
                } else {
                    pos.y -= (uMidLip + uAIModulation * 0.15) * 0.75;
                    pos.z += (uMidLip + uAIModulation * 0.15) * 0.35;
                }
            }

            float distToRipple = distance(pos, uRipplePos);
            if (distToRipple < 2.0 && uRippleTime > 0.0) {
                float wave = sin(distToRipple * 10.0 - uRippleTime * 15.0) * exp(-uRippleTime * 2.0) * 0.35;
                pos += normal * wave;
            }

            float ambientWave = sin(uTime * 3.0 + pos.y * 2.5 + uAIModulation * 5.0) * (0.02 + uHighSparks * 0.05 + uAIModulation * 0.08);
            pos += normal * ambientWave;

            vDisplacement = distance(position, pos);
            vPosition = pos;

            gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
        }
    </script>

    <!-- GLSL Fragment Shader -->
    <script id="fragmentShader" type="x-shader/x-fragment">
        uniform float uTime;
        uniform float uSubBass;
        uniform float uMidLip;
        uniform float uHighSparks;
        uniform int uSkinMode;
        uniform float uAIModulation;

        varying vec3 vNormal;
        varying vec3 vPosition;
        varying vec2 vUv;
        varying float vDisplacement;

        void main() {
            vec3 norm = normalize(vNormal);
            vec3 lightDir = normalize(vec3(2.0, 4.0, 5.0));
            float diff = max(dot(norm, lightDir), 0.15);
            vec3 color = vec3(0.04, 0.02, 0.08);

            if (uSkinMode == 0) {
                vec3 baseCol = mix(vec3(0.05, 0.03, 0.12), vec3(0.7 + uAIModulation * 0.3, 0.15, 0.85), vDisplacement * 3.0 + uMidLip * 0.5);
                color = baseCol * diff + vec3(0.1, 0.5, 0.9) * pow(diff, 4.0) * (0.5 + uHighSparks);
            } 
            else if (uSkinMode == 1) {
                float grid = step(0.85, fract(vUv.x * (20.0 + uAIModulation * 10.0))) + step(0.85, fract(vUv.y * 20.0));
                vec3 neon = mix(vec3(0.6, 0.1, 0.9), vec3(0.1, 0.8, 0.9), uMidLip * 2.0 + uAIModulation);
                color = neon * (grid + 0.3) * (diff + uSubBass * 0.5);
            }
            else if (uSkinMode == 2) {
                vec3 crystalCol = mix(vec3(0.2, 0.05, 0.4), vec3(0.85, 0.3, 1.0), sin(vPosition.x * 3.0 + uTime + uAIModulation * 10.0) * 0.5 + 0.5);
                color = crystalCol * diff * 1.4 + vec3(0.6, 0.2, 1.0) * uHighSparks * 0.8;
            }
            else {
                vec3 glassCol = mix(vec3(0.08, 0.05, 0.2), vec3(0.3, 0.7, 0.95), dot(norm, vec3(0.0, 0.0, 1.0)));
                color = glassCol * (diff + 0.5) + vec3(0.8 + uAIModulation * 0.2, 0.2, 0.9) * (vDisplacement * 4.0);
            }

            gl_FragColor = vec4(color, 0.95);
        }
    </script>

