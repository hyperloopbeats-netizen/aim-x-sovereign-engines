<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HyperFace Studio Pro v15.0 - Ultimate Premiere 3D Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #020617;
            font-family: 'Inter', sans-serif;
            user-select: none;
            -webkit-user-select: none;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        .glass-obsidian {
            background: rgba(10, 15, 30, 0.96);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border: 1px solid rgba(56, 189, 248, 0.4);
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.95), inset 0 0 25px rgba(56, 189, 248, 0.12);
        }
        .glass-tab-active {
            background: rgba(14, 165, 233, 0.55);
            border-color: rgba(56, 189, 248, 0.95);
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.6);
        }
        ::-webkit-scrollbar {
            width: 3px;
            height: 3px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.3);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(56, 189, 248, 0.5);
            border-radius: 3px;
        }
        .timeline-clip-visual {
            position: absolute;
            top: 6px;
            bottom: 6px;
            background: linear-gradient(90deg, rgba(14,165,233,0.65), rgba(56,189,248,0.9));
            border: 1px solid rgba(125, 211, 252, 0.95);
            border-radius: 8px;
            display: flex;
            align-items: center;
            padding: 0 10px;
            font-size: 10px;
            font-family: monospace;
            color: #f0f9ff;
            cursor: pointer;
            box-shadow: 0 4px 18px rgba(14,165,233,0.5);
            overflow: hidden;
            white-space: nowrap;
        }
    </style>
</head>
<body class="text-white relative w-screen h-screen flex flex-col justify-between overflow-hidden">

    <!-- PREMIERE MOBILE TOP BAR -->
    <header class="h-12 glass-obsidian z-40 flex items-center justify-between px-3 border-b border-sky-500/30">
        <div class="flex items-center space-x-2">
            <button id="btn-back" class="w-7 h-7 rounded-lg bg-sky-950/60 border border-sky-500/40 flex items-center justify-center text-sky-300 font-bold text-xs cursor-pointer">⟨</button>
            <span class="text-xs font-black tracking-widest bg-gradient-to-r from-sky-300 via-indigo-300 to-cyan-300 bg-clip-text text-transparent">HYPERFACE STUDIO v15.0</span>
        </div>
        <div class="flex items-center space-x-2">
            <button id="btn-fullscreen" class="px-2.5 py-1 rounded-lg bg-sky-950/40 hover:bg-sky-900/60 border border-sky-500/30 text-[10px] font-mono text-sky-200 cursor-pointer">⤢ FULLSCREEN</button>
            <button id="btn-export" class="px-3 py-1 rounded-lg bg-gradient-to-r from-sky-600 to-indigo-600 hover:opacity-90 font-bold text-[10px] text-white shadow-md cursor-pointer">RENDER 4K</button>
        </div>
    </header>

    <!-- MAIN 3D EDITOR VIEWPORT (PREMIERE MONITOR) -->
    <div id="viewport-container" class="relative flex-1 w-full bg-black overflow-hidden flex items-center justify-center">
        <div id="canvas-container" class="absolute inset-0 z-0"></div>
        
        <!-- Hidden Video Element for Real-Time Texture Mapping -->
        <video id="source-video" loop muted playsinline crossorigin="anonymous" class="hidden"></video>

        <!-- Viewport Status HUD -->
        <div class="absolute top-3 left-3 z-10 glass-obsidian px-3 py-1.5 rounded-xl font-mono text-[10px] text-sky-300 flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full bg-sky-400 animate-ping"></span>
            <span id="viewport-status">HD VIDEO TEXTURE PROJECTION MAPPED ONTO 3D FACE</span>
        </div>

        <div class="absolute bottom-3 right-3 z-10 glass-obsidian px-2.5 py-1 rounded-lg font-mono text-[9px] text-sky-300/80">
            FPS: <span id="fps-display" class="text-white">60</span>
        </div>
    </div>

    <!-- PREMIERE TIMELINE SCRUBBER & CLIP TRACK -->
    <footer id="timeline-section" class="glass-obsidian z-40 flex flex-col p-2.5 border-t border-sky-500/30 space-y-2">
        <div class="flex items-center justify-between px-1">
            <div class="flex items-center space-x-1.5 font-mono text-xs">
                <button id="tl-play" class="px-3 py-1.5 rounded-lg bg-sky-600/50 hover:bg-sky-600/70 border border-sky-400/50 font-bold text-sky-100 cursor-pointer">▶ PLAY</button>
                <button id="tl-stop" class="px-2.5 py-1.5 rounded-lg bg-black/60 border border-sky-500/30 text-sky-300 cursor-pointer">⏹ STOP</button>
                <button id="tl-loop" class="px-2.5 py-1.5 rounded-lg bg-sky-950/60 border border-sky-500/40 text-sky-300 cursor-pointer">🔁 LOOP</button>
            </div>
            <div class="font-mono text-xs text-sky-200 bg-black/50 px-3 py-1 rounded-lg border border-sky-500/30">
                <span id="timecode-display" class="font-bold text-sky-400">0.00s</span> / <span id="duration-display">10.00s</span>
            </div>
        </div>

        <!-- Timeline Track Area -->
        <div class="relative h-16 bg-black/80 rounded-xl border border-sky-500/30 overflow-hidden cursor-pointer" id="timeline-track-area">
            <!-- Playhead -->
            <div id="timeline-playhead" class="absolute top-0 bottom-0 w-0.5 bg-sky-400 z-20 pointer-events-none" style="left: 0%;">
                <div class="w-3 h-3 bg-sky-400 rounded-full -ml-1.5 -mt-1 shadow-md shadow-sky-400"></div>
            </div>
            <!-- Video Clip Item rendered on timeline when loaded -->
            <div id="timeline-clip-item" class="timeline-clip-visual left-0 w-full" style="display:none;">
                🎬 <span id="clip-title-label" class="ml-1 font-bold truncate">active_clip.mp4</span> (HD Video Projection Track)
            </div>
            <div class="absolute bottom-1 left-2 font-mono text-[8px] text-sky-400/80 pointer-events-none">V1 // REAL-TIME HD VIDEO TEXTURE MAPPED TRACK</div>
        </div>
    </footer>

    <!-- MOBILE BOTTOM NAVIGATION -->
    <nav class="glass-obsidian h-16 z-50 flex items-center justify-around px-2 border-t border-sky-500/40 font-mono text-[10px]">
        <button class="tool-tab flex flex-col items-center text-sky-300 cursor-pointer p-1 glass-tab-active rounded-xl" data-drawer="drawer-clip">
            <span class="text-base mb-0.5">📂</span><span>CLIP</span>
        </button>
        <button class="tool-tab flex flex-col items-center text-sky-300 cursor-pointer p-1" data-drawer="drawer-mesh">
            <span class="text-base mb-0.5">🗿</span><span>FACE MASK</span>
        </button>
        <button class="tool-tab flex flex-col items-center text-sky-300 cursor-pointer p-1" data-drawer="drawer-shader">
            <span class="text-base mb-0.5">✨</span><span>SHADER</span>
        </button>
        <button class="tool-tab flex flex-col items-center text-sky-300 cursor-pointer p-1" data-drawer="drawer-lights">
            <span class="text-base mb-0.5">💡</span><span>LIGHTS</span>
        </button>
        <button class="tool-tab flex flex-col items-center text-sky-300 cursor-pointer p-1" data-drawer="drawer-audio">
            <span class="text-base mb-0.5">🎵</span><span>AUDIO</span>
        </button>
    </nav>

    <!-- COLLAPSIBLE DRAWERS -->
    <div id="drawer-container" class="absolute bottom-16 inset-x-0 z-40 pointer-events-none p-3 transition-all duration-300 flex flex-col justify-end">
        
        <!-- CLIP DRAWER -->
        <div id="drawer-clip" class="glass-obsidian rounded-3xl p-4 pointer-events-auto shadow-2xl space-y-3">
            <div class="flex justify-between items-center pb-2 border-b border-sky-500/30">
                <h3 class="text-xs font-black tracking-wider text-sky-200 font-mono">📂 LOAD CLIP & PROJECT ONTO FACE</h3>
                <button class="text-sky-400 hover:text-white text-xs cursor-pointer close-drawer">✕</button>
            </div>
            <label class="flex flex-col items-center justify-center p-5 border-2 border-dashed border-sky-500/50 hover:border-sky-400 rounded-2xl bg-black/60 cursor-pointer transition">
                <span class="text-sm font-bold text-sky-100 mb-1">📼 UPLOAD VIDEO CLIP (.MP4 / .MOV)</span>
                <span class="text-[9px] font-mono text-sky-300/70 text-center">Instantly projects crisp real-time video frames onto 3D face geometry & timeline</span>
                <input type="file" id="video-file-input" accept="video/mp4,video/mov,video/*" class="hidden">
            </label>
            <div id="clip-status-msg" class="text-[9px] text-sky-300 font-mono bg-black/60 p-2.5 rounded-xl border border-sky-500/30 text-center">
                STATUS: READY FOR VIDEO FILE UPLOAD
            </div>
        </div>

        <!-- FACE MASK DRAWER -->
        <div id="drawer-mesh" class="glass-obsidian rounded-3xl p-4 pointer-events-auto shadow-2xl space-y-3 hidden">
            <div class="flex justify-between items-center pb-2 border-b border-sky-500/30">
                <h3 class="text-xs font-black tracking-wider text-sky-200 font-mono">🗿 3D FACE MASK GEOMETRY</h3>
                <button class="text-sky-400 hover:text-white text-xs cursor-pointer close-drawer">✕</button>
            </div>
            <div>
                <label class="text-[9px] text-sky-300/80 font-mono block mb-1">SELECT MASK MODEL</label>
                <select id="asset-select" class="w-full bg-black/70 border border-sky-500/30 rounded-xl p-2.5 text-xs text-sky-100 font-bold focus:outline-none cursor-pointer">
                    <option value="face">Detailed 3D Face Mask</option>
                    <option value="skull">Cybernetic Skull</option>
                    <option value="mech">Mech Droid Core</option>
                    <option value="crystal">Monolith Crystal</option>
                </select>
            </div>
        </div>

        <!-- SHADER DRAWER -->
        <div id="drawer-shader" class="glass-obsidian rounded-3xl p-4 pointer-events-auto shadow-2xl space-y-3 hidden">
            <div class="flex justify-between items-center pb-2 border-b border-sky-500/30">
                <h3 class="text-xs font-black tracking-wider text-sky-200 font-mono">✨ RENDER & TEXTURE MODE</h3>
                <button class="text-sky-400 hover:text-white text-xs cursor-pointer close-drawer">✕</button>
            </div>
            <div>
                <label class="text-[9px] text-sky-300/80 font-mono block mb-1">SURFACE TEXTURE</label>
                <select id="skin-select" class="w-full bg-black/70 border border-sky-500/30 rounded-xl p-2.5 text-xs text-sky-100 font-bold focus:outline-none cursor-pointer">
                    <option value="video">🎥 Active Video Texture Projection</option>
                    <option value="0">Obsidian Metallic Chrome</option>
                    <option value="1">Electric Blue Wireframe</option>
                    <option value="2">Quantum Plasma Glow</option>
                </select>
            </div>
        </div>

        <!-- LIGHTS DRAWER -->
        <div id="drawer-lights" class="glass-obsidian rounded-3xl p-4 pointer-events-auto shadow-2xl space-y-3 hidden">
            <div class="flex justify-between items-center pb-2 border-b border-sky-500/30">
                <h3 class="text-xs font-black tracking-wider text-sky-200 font-mono">💡 LIGHTING DIRECTOR</h3>
                <button class="text-sky-400 hover:text-white text-xs cursor-pointer close-drawer">✕</button>
            </div>
            <div class="space-y-3">
                <div>
                    <div class="flex justify-between text-[9px] font-mono text-sky-200 mb-1"><span>ELECTRIC BLUE KEY LIGHT</span><span id="val-light-sky">12.0</span></div>
                    <input type="range" id="slider-light-sky" min="0" max="25" step="0.5" value="12" class="w-full cursor-pointer accent-sky-400">
                </div>
            </div>
        </div>

        <!-- AUDIO DRAWER -->
        <div id="drawer-audio" class="glass-obsidian rounded-3xl p-4 pointer-events-auto shadow-2xl space-y-3 hidden">
            <div class="flex justify-between items-center pb-2 border-b border-sky-500/30">
                <h3 class="text-xs font-black tracking-wider text-sky-200 font-mono">🎵 AUDIO & BEAT SYNC</h3>
                <button class="text-sky-400 hover:text-white text-xs cursor-pointer close-drawer">✕</button>
            </div>
            <div class="space-y-2">
                <button id="synth-btn" class="w-full py-2.5 rounded-xl text-xs font-bold bg-sky-600/40 hover:bg-sky-600/60 border border-sky-500/50 text-sky-200 cursor-pointer">⚡ GENERATE CYBER BEAT</button>
            </div>
        </div>

    </div>

    <!-- NOTIFICATION TOAST -->
    <div id="msg-box" class="fixed bottom-24 left-1/2 transform -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-opacity duration-300">
        <div id="msg-content" class="glass-obsidian px-5 py-2.5 rounded-xl text-xs font-bold shadow-2xl border border-sky-500/50 text-sky-200"></div>
    </div>

    <!-- SCRIPT LOGIC -->
    <script>
        function showMessage(text) {
            const box = document.getElementById('msg-box');
            const content = document.getElementById('msg-content');
            content.textContent = text;
            box.style.opacity = '1';
            setTimeout(() => { box.style.opacity = '0'; }, 3000);
        }

        function openDrawer(drawerId) {
            ['drawer-clip', 'drawer-mesh', 'drawer-shader', 'drawer-lights', 'drawer-audio'].forEach(id => {
                document.getElementById(id).classList.add('hidden');
            });
            document.querySelectorAll('.tool-tab').forEach(btn => {
                btn.classList.remove('glass-tab-active');
            });
            document.getElementById(drawerId).classList.remove('hidden');
            const activeBtn = document.querySelector(`.tool-tab[data-drawer="${drawerId}"]`);
            if (activeBtn) activeBtn.classList.add('glass-tab-active');
        }

        document.querySelectorAll('.tool-tab').forEach(btn => {
            btn.addEventListener('click', () => openDrawer(btn.getAttribute('data-drawer')));
        });

        document.querySelectorAll('.close-drawer').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.target.closest('div.glass-obsidian').classList.add('hidden');
            });
        });

        let isFullScreen = false;
        document.getElementById('btn-fullscreen').addEventListener('click', () => {
            isFullScreen = !isFullScreen;
            const timeline = document.getElementById('timeline-section');
            const nav = document.querySelector('nav');
            if (isFullScreen) {
                timeline.style.display = 'none';
                nav.style.display = 'none';
                document.getElementById('btn-fullscreen').textContent = '⤫ EXIT FULL';
                showMessage("Entered Fullscreen 3D View");
            } else {
                timeline.style.display = 'flex';
                nav.style.display = 'flex';
                document.getElementById('btn-fullscreen').textContent = '⤢ FULLSCREEN';
                showMessage("Exited Fullscreen View");
            }
            onWindowResize();
        });

        // THREE.JS SETUP & REAL-TIME TEXTURE MAPPING
        let scene, camera, renderer, controls, activeMesh, videoTexture, videoElement, isVideoLoaded = false;
        let keyLight;
        let clock = new THREE.Clock();
        let isPlaying = false, currentTime = 0, duration = 10.0;

        function initThree() {
            const container = document.getElementById('canvas-container');
            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x020617, 0.015);

            camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 1000);
            camera.position.set(0, 0, 3.8);

            renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            container.appendChild(renderer.domElement);

            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;

            const ambient = new THREE.AmbientLight(0x0f172a, 1.8);
            scene.add(ambient);

            keyLight = new THREE.PointLight(0x38bdf8, 12, 35);
            keyLight.position.set(4, 4, 5);
            scene.add(keyLight);

            videoElement = document.getElementById('source-video');

            loadAsset('face');
            setupVideoUpload();
            setupUIControls();
            
            window.addEventListener('resize', onWindowResize);
        }

        // High-Resolution Procedural 3D Face Mask Geometry with clean UVs for crisp unpixelated mapping
        function createFaceMaskGeometry() {
            const geom = new THREE.SphereGeometry(1.5, 128, 128);
            const pos = geom.attributes.position;
            for (let i = 0; i < pos.count; i++) {
                let x = pos.getX(i);
                let y = pos.getY(i);
                let z = pos.getZ(i);
                if (z < 0) {
                    z *= 0.8; // Flatten back
                } else {
                    // Sculpt facial contours (brow, nose bridge, cheekbones, chin)
                    let contour = Math.cos(x * 1.5) * Math.cos(y * 1.2) * 0.25;
                    z += contour;
                }
                pos.setXYZ(i, x, y, z);
            }
            geom.computeVertexNormals();
            return geom;
        }

        function loadAsset(type) {
            if (activeMesh) scene.remove(activeMesh);
            
            let geometry = type === 'face' ? createFaceMaskGeometry() :
                           type === 'skull' ? new THREE.SphereGeometry(1.4, 64, 64) :
                           type === 'mech' ? new THREE.BoxGeometry(1.8, 1.8, 1.8, 32, 32, 32) :
                           new THREE.ConeGeometry(1.3, 3.0, 48);

            let material;
            const skinMode = document.getElementById('skin-select').value;

            if (skinMode === 'video' && isVideoLoaded) {
                videoTexture = new THREE.VideoTexture(videoElement);
                videoTexture.minFilter = THREE.LinearFilter;
                videoTexture.magFilter = THREE.LinearFilter;
                videoTexture.generateMipmaps = false;
                videoTexture.colorSpace = THREE.SRGBColorSpace;
                
                material = new THREE.MeshBasicMaterial({ 
                    map: videoTexture, 
                    side: THREE.DoubleSide 
                });
            } else if (skinMode === '0') {
                material = new THREE.MeshStandardMaterial({ color: 0x38bdf8, metalness: 0.9, roughness: 0.1, side: THREE.DoubleSide });
            } else if (skinMode === '1') {
                material = new THREE.MeshStandardMaterial({ color: 0x0ea5e9, wireframe: true, side: THREE.DoubleSide });
            } else {
                material = new THREE.MeshStandardMaterial({ color: 0x818cf8, emissive: 0x0284c7, emissiveIntensity: 0.5, side: THREE.DoubleSide });
            }

            activeMesh = new THREE.Mesh(geometry, material);
            scene.add(activeMesh);
        }

        function setupVideoUpload() {
            const input = document.getElementById('video-file-input');
            input.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) return;

                const fileURL = URL.createObjectURL(file);
                videoElement.src = fileURL;
                videoElement.load();
                
                videoElement.onloadedmetadata = () => {
                    duration = videoElement.duration || 10.0;
                    document.getElementById('duration-display').textContent = duration.toFixed(2) + 's';
                };

                videoElement.play().then(() => {
                    isVideoLoaded = true;
                    document.getElementById('clip-title-label').textContent = file.name;
                    document.getElementById('timeline-clip-item').style.display = 'flex';
                    document.getElementById('clip-status-msg').innerHTML = `STATUS: <span class="text-green-400 font-bold">HD CLIP LOADED & MAPPED (${file.name})</span>`;
                    
                    document.getElementById('skin-select').value = 'video';
                    loadAsset(document.getElementById('asset-select').value);
                    
                    isPlaying = true;
                    document.getElementById('tl-play').textContent = "⏸ PAUSE";
                    showMessage("HD Video successfully mapped onto 3D Face & Timeline!");
                }).catch(err => {
                    console.error(err);
                    showMessage("Playback error on uploaded video file.");
                });
            });
        }

        function setupUIControls() {
            document.getElementById('asset-select').addEventListener('change', (e) => loadAsset(e.target.value));
            document.getElementById('skin-select').addEventListener('change', () => loadAsset(document.getElementById('asset-select').value));

            document.getElementById('slider-light-sky').addEventListener('input', (e) => {
                const val = parseFloat(e.target.value);
                document.getElementById('val-light-sky').textContent = val.toFixed(1);
                if (keyLight) keyLight.intensity = val;
            });

            document.getElementById('tl-play').addEventListener('click', () => {
                isPlaying = !isPlaying;
                document.getElementById('tl-play').textContent = isPlaying ? "⏸ PAUSE" : "▶ PLAY";
                if (isVideoLoaded) {
                    if (isPlaying) videoElement.play();
                    else videoElement.pause();
                }
            });

            document.getElementById('tl-stop').addEventListener('click', () => {
                isPlaying = false;
                currentTime = 0;
                document.getElementById('tl-play').textContent = "▶ PLAY";
                if (isVideoLoaded) {
                    videoElement.pause();
                    videoElement.currentTime = 0;
                }
            });

            // Interactive timeline scrubbing
            const trackArea = document.getElementById('timeline-track-area');
            trackArea.addEventListener('click', (e) => {
                const rect = trackArea.getBoundingClientRect();
                const clickX = e.clientX - rect.left;
                const pct = Math.max(0, Math.min(1, clickX / rect.width));
                currentTime = pct * duration;
                if (isVideoLoaded && videoElement.duration) {
                    videoElement.currentTime = pct * videoElement.duration;
                }
            });
        }

        function onWindowResize() {
            const container = document.getElementById('viewport-container');
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        let fpsFrames = 0, fpsTime = 0;
        function animate() {
            requestAnimationFrame(animate);
            const delta = clock.getDelta();

            fpsFrames++;
            fpsTime += delta;
            if (fpsTime >= 1.0) {
                document.getElementById('fps-display').textContent = fpsFrames;
                fpsFrames = 0;
                fpsTime = 0;
            }

            controls.update();

            if (isPlaying) {
                if (isVideoLoaded && !videoElement.paused) {
                    currentTime = videoElement.currentTime;
                    if (videoElement.ended || currentTime >= duration) {
                        currentTime = 0;
                        videoElement.currentTime = 0;
                    }
                } else {
                    currentTime += delta;
                    if (currentTime >= duration) currentTime = 0;
                }
            }

            document.getElementById('timecode-display').textContent = currentTime.toFixed(2) + 's';
            document.getElementById('timeline-playhead').style.left = `${(currentTime / duration) * 100}%`;

            if (activeMesh) {
                activeMesh.rotation.y += delta * 0.35;
                if (videoTexture && isVideoLoaded) {
                    videoTexture.needsUpdate = true;
                }
            }

            renderer.render(scene, camera);
        }

        window.onload = () => {
            initThree();
            animate();
        };
    </script>
</body>
</html>
