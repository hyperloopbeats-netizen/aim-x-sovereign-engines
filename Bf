    <!-- GLSL Vertex Shader -->
    <script id="vertexShader" type="x-shader/x-vertex">
        uniform float uTime;
        uniform int uAudioDriven;
        
        uniform float uVisOpen;
        uniform float uVisWide;
        uniform float uVisRound;
        uniform float uVisClosed;
        uniform float uVisBite;

        uniform float uExpJoy;
        uniform float uExpAnger;
        uniform float uExpSurprise;
        uniform float uExpSad;

        uniform float uSubBass;
        uniform float uMidLip;

        uniform vec3 uRipplePos;
        uniform float uRippleTime;

        varying vec3 vNormal;
        varying vec3 vPosition;
        varying vec2 vUv;
        varying float vDisplacement;

        void main() {
            vUv = uv;
            vNormal = normal;
            vec3 pos = position;

            float openVal = uAudioDriven == 1 ? uSubBass * 1.3 : uVisOpen;
            float wideVal = uAudioDriven == 1 ? uMidLip * 1.1 : uVisWide;
            float roundVal = uVisRound;
            float closedVal = uVisClosed;
            float biteVal = uVisBite;

            float joy = uExpJoy;
            float anger = uExpAnger;
            float surprise = uExpSurprise;
            float sad = uExpSad;

            // --- 1. VISEME MOUTH MATRIX DEFORMATION ---
            float distToMouth = length(pos.xy - vec2(0.0, -0.38));
            if (distToMouth < 0.6 && pos.z > 0.2) {
                if (pos.y < -0.3) {
                    pos.y -= openVal * 0.55;
                    pos.z += openVal * 0.25;
                }
                if (abs(pos.x) > 0.15 && abs(pos.y + 0.38) < 0.2) {
                    pos.x += sign(pos.x) * wideVal * 0.35;
                }
                if (distToMouth < 0.35) {
                    pos.z += roundVal * 0.45;
                    pos.x *= (1.0 - roundVal * 0.25);
                }
                if (abs(pos.y + 0.38) < 0.15) {
                    pos.y = mix(pos.y, -0.38, closedVal * 0.8);
                    pos.z += closedVal * 0.2;
                }
                if (pos.y > -0.35 && pos.y < -0.2) {
                    pos.z -= biteVal * 0.3;
                } else if (pos.y <= -0.35) {
                    pos.y += biteVal * 0.25;
                    pos.z += biteVal * 0.2;
                }
            }

            // --- 2. FACIAL EXPRESSIONS MATRIX ---
            if (pos.y > -0.4 && pos.y < -0.2 && abs(pos.x) > 0.25) {
                pos.y += joy * 0.25 * (1.0 - abs(pos.x) * 0.5);
                pos.z += joy * 0.15;
            }
            if (pos.y > 0.45 && abs(pos.x) < 0.35) {
                pos.y -= anger * 0.2;
                pos.z += anger * 0.15;
                pos.x *= (1.0 - anger * 0.2);
            }
            if (pos.y > 0.45) {
                pos.y += surprise * 0.3;
            }
            if (pos.y < -0.3 && pos.z > 0.2) {
                pos.y -= surprise * 0.4;
            }
            if (pos.y > 0.45 && abs(pos.x) < 0.3) {
                pos.y += sad * 0.2;
            }
            if (pos.y > -0.4 && pos.y < -0.2 && abs(pos.x) > 0.25) {
                pos.y -= sad * 0.2;
            }

            // --- 3. RAYCAST SHOCKWAVE RIPPLE ---
            float distToRipple = distance(pos, uRipplePos);
            if (distToRipple < 2.0 && uRippleTime > 0.0) {
                float wave = sin(distToRipple * 10.0 - uRippleTime * 15.0) * exp(-uRippleTime * 2.0) * 0.35;
                pos += normal * wave;
            }

            float ambientWave = sin(uTime * 2.5 + pos.y * 2.0) * 0.015;
            pos += normal * ambientWave;

            vDisplacement = distance(position, pos);
            vPosition = pos;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
        }
    </script>

    <!-- GLSL Fragment Shader -->
    <script id="fragmentShader" type="x-shader/x-fragment">
        uniform float uTime;
        uniform int uSkinMode;
        varying vec3 vNormal;
        varying vec3 vPosition;
        varying vec2 vUv;
        varying float vDisplacement;

        void main() {
            vec3 norm = normalize(vNormal);
            vec3 lightDir = normalize(vec3(2.0, 4.0, 5.0));
            float diff = max(dot(norm, lightDir), 0.15);

            vec3 color = vec3(0.05, 0.05, 0.12);

            if (uSkinMode == 0) {
                vec3 baseCol = mix(vec3(0.04, 0.06, 0.15), vec3(0.8, 0.2, 0.9), vDisplacement * 4.0);
                color = baseCol * diff + vec3(0.0, 0.6, 0.8) * pow(diff, 4.0);
            } else if (uSkinMode == 1) {
                float grid = step(0.85, fract(vUv.x * 20.0)) + step(0.85, fract(vUv.y * 20.0));
                color = vec3(0.0, 0.9, 0.9) * (grid + 0.4) * diff;
            } else {
                color = mix(vec3(0.1, 0.3, 0.6), vec3(0.9, 0.4, 1.0), sin(vPosition.x * 3.0 + uTime) * 0.5 + 0.5) * diff * 1.3;
            }

            gl_FragColor = vec4(color, 0.94);
        }
    </script>

    <script>
        function showMessage(text) {
            const box = document.getElementById('msg-box');
            const content = document.getElementById('msg-content');
            content.textContent = text;
            box.style.opacity = '1';
            setTimeout(() => { box.style.opacity = '0'; }, 3000);
        }

        let scene, camera, renderer, controls;
        let faceMesh, customMaterial;
        let clock = new THREE.Clock();

        let audioCtx, audioAnalyser, audioSource;
        let isAudioDriven = false, isMicActive = false;
        let audioDataArray;
        let isSynthPlaying = false, synthOscs = [];

        // Raycasting for interactive surface ripples
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        let ripplePos = new THREE.Vector3(0, -0.4, 0.5);
        let rippleTime = -1.0;

        // Smooth interpolation targets for typing & sliders
        const targetVisemes = { open: 0, wide: 0, round: 0, closed: 0, bite: 0 };
        const currentVisemes = { open: 0, wide: 0, round: 0, closed: 0, bite: 0 };
        const targetExpressions = { joy: 0, anger: 0, surprise: 0, sad: 0 };
        const currentExpressions = { joy: 0, anger: 0, surprise: 0, sad: 0 };

        const spectrumContainer = document.getElementById('spectrum-bars');
        const numBars = 16;
        const barElements = [];
        for (let i = 0; i < numBars; i++) {
            const bar = document.createElement('div');
            bar.className = 'w-1.5 bg-gradient-to-t from-cyan-400 via-fuchsia-500 to-purple-500 rounded-full';
            bar.style.height = '15%';
            spectrumContainer.appendChild(bar);
            barElements.push(bar);
        }

        function initThree() {
            const container = document.getElementById('canvas-container');
            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x020205, 0.02);

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 0, 5.2);

            renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(renderer.domElement);

            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;

            scene.add(new THREE.AmbientLight(0xffffff, 0.5));
            const pLight = new THREE.PointLight(0x06b6d4, 5, 20);
            pLight.position.set(5, 5, 5);
            scene.add(pLight);

            createFaceMesh();
            setupControls();
        }

        function createFaceMesh() {
            const geometry = new THREE.IcosahedronGeometry(1.6, 5);
            const posAttr = geometry.attributes.position;

            for (let i = 0; i < posAttr.count; i++) {
                let x = posAttr.getX(i), y = posAttr.getY(i), z = posAttr.getZ(i);
                if (z > 0) {
                    if (y > 0.4) { z += 0.22; x *= 0.9; }
                    if (Math.hypot(x - 0.45, y - 0.25) < 0.5 || Math.hypot(x + 0.45, y - 0.25) < 0.5) { z -= 0.4; }
                    if (Math.abs(x) < 0.3 && y > -0.5 && y < 0.4) { z += Math.max(0, 0.68 - Math.abs(x) * 2.0); }
                    if (y < -0.6) { x *= 0.85; z += 0.2; }
                } else { z *= 0.75; }
                posAttr.setXYZ(i, x, y, z);
            }
            geometry.computeVertexNormals();

            customMaterial = new THREE.ShaderMaterial({
                vertexShader: document.getElementById('vertexShader').textContent,
                fragmentShader: document.getElementById('fragmentShader').textContent,
                uniforms: {
                    uTime: { value: 0 },
                    uAudioDriven: { value: 0 },
                    uVisOpen: { value: 0 },
                    uVisWide: { value: 0 },
                    uVisRound: { value: 0 },
                    uVisClosed: { value: 0 },
                    uVisBite: { value: 0 },
                    uExpJoy: { value: 0 },
                    uExpAnger: { value: 0 },
                    uExpSurprise: { value: 0 },
                    uExpSad: { value: 0 },
                    uSubBass: { value: 0 },
                    uMidLip: { value: 0 },
                    uRipplePos: { value: new THREE.Vector3(0, -0.4, 0.5) },
                    uRippleTime: { value: -1.0 },
                    uSkinMode: { value: 0 }
                },
                side: THREE.DoubleSide
            });

            faceMesh = new THREE.Mesh(geometry, customMaterial);
            scene.add(faceMesh);
        }

        function setupControls() {
            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });

            // Click Raycasting for Surface Ripples
            renderer.domElement.addEventListener('click', (event) => {
                mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
                mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
                raycaster.setFromCamera(mouse, camera);
                const intersects = raycaster.intersectObject(faceMesh);
                if (intersects.length > 0) {
                    ripplePos.copy(intersects[0].point);
                    rippleTime = 0.0;
                    customMaterial.uniforms.uRipplePos.value.copy(ripplePos);
                    showMessage("⚡ Surface Ripple Triggered");
                }
            });

            // Slider bindings
            const bindSlider = (id, targetKey, valId, isViseme = true) => {
                const slider = document.getElementById(id);
                slider.addEventListener('input', (e) => {
                    const val = parseFloat(e.target.value);
                    if (isViseme) targetVisemes[targetKey] = val;
                    else targetExpressions[targetKey] = val;
                    document.getElementById(valId).textContent = val.toFixed(2);
                });
            };

            bindSlider('slider-vis-open', 'open', 'val-vis-open', true);
            bindSlider('slider-vis-wide', 'wide', 'val-vis-wide', true);
            bindSlider('slider-vis-round', 'round', 'val-vis-round', true);
            bindSlider('slider-vis-closed', 'closed', 'val-vis-closed', true);
            bindSlider('slider-vis-bite', 'bite', 'val-vis-bite', true);

            bindSlider('slider-exp-joy', 'joy', 'val-exp-joy', false);
            bindSlider('slider-exp-anger', 'anger', 'val-exp-anger', false);
            bindSlider('slider-exp-surprise', 'surprise', 'val-exp-surprise', false);
            bindSlider('slider-exp-sad', 'sad', 'val-exp-sad', false);

            // Prompt-to-Matrix Parser
            function parseTextToMatrix(text) {
                text = text.toLowerCase().trim();
                Object.keys(targetVisemes).forEach(k => targetVisemes[k] = 0);
                Object.keys(targetExpressions).forEach(k => targetExpressions[k] = 0);

                if (text.includes('smile') || text.includes('happy') || text.includes('joy')) {
                    targetExpressions.joy = 1.0;
                } else if (text.includes('angry') || text.includes('mad')) {
                    targetExpressions.anger = 1.0;
                } else if (text.includes('wow') || text.includes('surprised')) {
                    targetExpressions.surprise = 1.0;
                    targetVisemes.open = 0.8;
                } else {
                    for (let char of text) {
                        if ('aàáâãäå'.includes(char)) targetVisemes.open += 0.4;
                        if ('eéêë'.includes(char)) targetVisemes.wide += 0.4;
                        if ('oóôõö'.includes(char) || char === 'u') targetVisemes.round += 0.5;
                        if ('mývábp'.includes(char)) targetVisemes.closed += 0.6;
                        if ('fv'.includes(char)) targetVisemes.bite += 0.5;
                    }
                }
                for (let k in targetVisemes) targetVisemes[k] = Math.min(1.0, targetVisemes[k]);
                showMessage(`Translated Prompt: "${text}"`);
            }

            document.getElementById('prompt-submit').addEventListener('click', () => {
                const val = document.getElementById('prompt-input').value;
                if (val) parseTextToMatrix(val);
            });
            document.getElementById('prompt-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('prompt-submit').click();
            });

            // Mode Toggle
            document.getElementById('mode-toggle-btn').addEventListener('click', () => {
                isAudioDriven = !isAudioDriven;
                isMicActive = false;
                customMaterial.uniforms.uAudioDriven.value = isAudioDriven ? 1 : 0;
                document.getElementById('mode-toggle-btn').textContent = isAudioDriven ? "🎙️ MODE: AUDIO SPEECH" : "🎛️ MODE: MANUAL MATRIX";
                document.getElementById('viseme-mode-indicator').textContent = isAudioDriven ? "AUDIO FFT" : "MANUAL";
                document.getElementById('matrix-status').textContent = isAudioDriven ? "AUDIO ACTIVE" : "MANUAL MATRIX READY";
            });

            // Microphone Sync Toggle
            document.getElementById('mic-sync-btn').addEventListener('click', async () => {
                initAudioCtx();
                if (audioCtx.state === 'suspended') await audioCtx.resume();

                if (isMicActive) {
                    isMicActive = false;
                    isAudioDriven = false;
                    customMaterial.uniforms.uAudioDriven.value = 0;
                    document.getElementById('mic-sync-btn').classList.remove('bg-purple-600/60');
                    document.getElementById('mic-sync-btn').textContent = "🎙️ MIC SYNC: OFF";
                    showMessage("Microphone Viseme Sync Deactivated");
                    return;
                }

                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                    audioSource = audioCtx.createMediaStreamSource(stream);
                    audioSource.connect(audioAnalyser);
                    isMicActive = true;
                    isAudioDriven = true;
                    customMaterial.uniforms.uAudioDriven.value = 1;
                    document.getElementById('mic-sync-btn').classList.add('bg-purple-600/60');
                    document.getElementById('mic-sync-btn').textContent = "🎙️ MIC SYNC: ACTIVE";
                    showMessage("Microphone Active — Speak to animate mouth mesh");
                } catch (e) {
                    showMessage("Microphone access denied or unavailable.");
                }
            });

            document.getElementById('skin-select').addEventListener('change', (e) => {
                customMaterial.uniforms.uSkinMode.value = parseInt(e.target.value);
            });

            document.getElementById('synth-btn').addEventListener('click', toggleSynthBeat);
        }

        function initAudioCtx() {
            if (audioCtx) return;
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            audioAnalyser = audioCtx.createAnalyser();
            audioAnalyser.fftSize = 64;
            audioDataArray = new Uint8Array(audioAnalyser.frequencyBinCount);
        }

        function toggleSynthBeat() {
            initAudioCtx();
            if (audioCtx.state === 'suspended') audioCtx.resume();

            if (isSynthPlaying) {
                synthOscs.forEach(o => o.stop());
                synthOscs = [];
                isSynthPlaying = false;
                isAudioDriven = false;
                customMaterial.uniforms.uAudioDriven.value = 0;
                document.getElementById('matrix-status').textContent = "STANDBY";
                return;
            }

            isSynthPlaying = true;
            isAudioDriven = true;
            customMaterial.uniforms.uAudioDriven.value = 1;
            document.getElementById('matrix-status').textContent = "SYNTH SPEECH ACTIVE";

            const osc1 = audioCtx.createOscillator();
            const osc2 = audioCtx.createOscillator();
            const lfo = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            osc1.type = 'sawtooth'; osc1.frequency.value = 55;
            osc2.type = 'square'; osc2.frequency.value = 110;
            lfo.type = 'sine'; lfo.frequency.value = 4.0;

            const lfoGain = audioCtx.createGain();
            lfoGain.gain.value = 30;
            lfo.connect(lfoGain);
            lfoGain.connect(osc2.frequency);

            osc1.connect(gain);
            osc2.connect(gain);
            gain.gain.value = 0.25;
            gain.connect(audioAnalyser);
            audioAnalyser.connect(audioCtx.destination);

            osc1.start(); osc2.start(); lfo.start();
            synthOscs = [osc1, osc2, lfo];
        }

        let frameCount = 0, lastTime = performance.now();

        function animate() {
            requestAnimationFrame(animate);
            const delta = clock.getDelta();
            const elapsedTime = clock.getElapsedTime();

            // FPS Counter
            frameCount++;
            const now = performance.now();
            if (now - lastTime >= 1000) {
                document.getElementById('fps-display').textContent = frameCount;
                frameCount = 0;
                lastTime = now;
            }

            controls.update();

            // Smooth interpolation (spring lerp) for manual sliders and prompt text
            const lerpSpeed = delta * 8.0;
            for (let k in currentVisemes) {
                currentVisemes[k] += (targetVisemes[k] - currentVisemes[k]) * lerpSpeed;
                currentExpressions[k] += (targetExpressions[k] - currentExpressions[k]) * lerpSpeed;
            }

            customMaterial.uniforms.uVisOpen.value = currentVisemes.open;
            customMaterial.uniforms.uVisWide.value = currentVisemes.wide;
            customMaterial.uniforms.uVisRound.value = currentVisemes.round;
            customMaterial.uniforms.uVisClosed.value = currentVisemes.closed;
            customMaterial.uniforms.uVisBite.value = currentVisemes.bite;

            customMaterial.uniforms.uExpJoy.value = currentExpressions.joy;
            customMaterial.uniforms.uExpAnger.value = currentExpressions.anger;
            customMaterial.uniforms.uExpSurprise.value = currentExpressions.surprise;
            customMaterial.uniforms.uExpSad.value = currentExpressions.sad;

            // Audio Analysis
            if (audioAnalyser && isAudioDriven) {
                audioAnalyser.getByteFrequencyData(audioDataArray);
                let subSum = 0, midSum = 0;
                for (let i = 0; i < 4; i++) subSum += audioDataArray[i];
                for (let i = 4; i < 12; i++) midSum += audioDataArray[i];

                customMaterial.uniforms.uSubBass.value = (subSum / 4) / 255.0;
                customMaterial.uniforms.uMidLip.value = (midSum / 8) / 255.0;

                for (let i = 0; i < numBars; i++) {
                    barElements[i].style.height = `${Math.max(10, (audioDataArray[i*2]/255.0)*100)}%`;
                }
            } else {
                for (let i = 0; i < numBars; i++) {
                    barElements[i].style.height = `${Math.sin(elapsedTime*5 + i*0.3)*25 + 35}%`;
                }
            }

            customMaterial.uniforms.uTime.value = elapsedTime;

            if (rippleTime >= 0.0) {
                rippleTime += delta;
                customMaterial.uniforms.uRippleTime.value = rippleTime;
                if (rippleTime > 2.5) rippleTime = -1.0;
            }

            renderer.render(scene, camera);
        }

        window.onload = () => { initThree(); animate(); };
    </script>
</body>
</html>
