      function activateMediaStage(type, name) {
        kernel.media.loaded = true;
        kernel.media.type = type;
        kernel.media.name = name || 'reel.mp4';
        document.body.classList.add('has-media');

        videoEl.style.display = type === 'video' ? 'block' : 'none';
        imageEl.style.display = type === 'image' ? 'block' : 'none';
