        let matteH = 0;
        if (kernel.viewMode === 'movie' && kernel.scopeEnabled && availH > scope239H) {
          matteH = Math.min(
            Math.floor(availH * 0.42),
            Math.max(0, Math.floor((availH - scope239H) / 2) + extraTheatre)
          );
        } else if (kernel.viewMode === 'movie' && kernel.theatreView) {
          matteH = Math.min(36, Math.floor(availH * 0.08));
