        document.documentElement.style.setProperty('--matte-h', `${matteH}px`);
        document.body.classList.toggle('scope-on', kernel.viewMode === 'movie' && (kernel.scopeEnabled || kernel.theatreView) && matteH > 0);

        const scopeTopBtn = document.getElementById('scopeTopBtn');
