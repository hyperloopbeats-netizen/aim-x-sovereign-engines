        syncViewModeUi();
        syncScopeMattes();
        syncMediaTransform();
        syncPlaybackUi();
        renderLiquid8kPass(kernel.elapsed);
      }

      function launchBuiltInStream() {
        releaseObjectUrl();
        try { videoEl.pause(); } catch (_) {}
        videoEl.removeAttribute('src');
        kernel.media.playing = true;
        activateMediaStage('stream', 'CinemaScope_239_Stream.mp4');
        renderStreamFrame(kernel.elapsed);
        renderLiquid8kPass(kernel.elapsed);
        showToast('Streaming 2.39:1 CinemaScope reel');
        FractalBrain.emit('MEDIA_LOADED', { type: 'stream', name: kernel.media.name });
      }

      function loadUserFile(file) {
        if (!file) return;
        releaseObjectUrl();
        const url = URL.createObjectURL(file);
        kernel.media.objectUrl = url;
        const isImage = file.type.startsWith('image/') || /\.(png|jpe?g|webp|gif)$/i.test(file.name);

        if (isImage) {
          try { videoEl.pause(); } catch (_) {}
          videoEl.removeAttribute('src');
          imageEl.onload = function () {
            kernel.media.playing = false;
            activateMediaStage('image', file.name);
            renderLiquid8kPass(kernel.elapsed);
            showToast(`Projected image: ${file.name}`);
            FractalBrain.emit('MEDIA_LOADED', { type: 'image', name: file.name });
          };
          imageEl.src = url;
          return;
        }

        videoEl.muted = kernel.media.muted;
        videoEl.src = url;
        videoEl.load();
        const tryPlay = function () {
          const p = videoEl.play();
          if (p && typeof p.then === 'function') {
            p.then(function () {
              kernel.media.playing = true;
              activateMediaStage('video', file.name);
              showToast(`Streaming MP4: ${file.name}`);
              FractalBrain.emit('MEDIA_LOADED', { type: 'video', name: file.name });
            }).catch(function () {
              kernel.media.playing = false;
              activateMediaStage('video', file.name);
              showToast(`Loaded ${file.name} — tap Play`);
              FractalBrain.emit('MEDIA_LOADED', { type: 'video', name: file.name });
            });
          } else {
            kernel.media.playing = !videoEl.paused;
            activateMediaStage('video', file.name);
            FractalBrain.emit('MEDIA_LOADED', { type: 'video', name: file.name });
          }
        };
        videoEl.onloadedmetadata = tryPlay;
        videoEl.onerror = function () {
          showToast('Could not decode video file; switched to 2.39:1 stream');
          launchBuiltInStream();
        };
      }

      function getActiveMediaSource() {
        if (!kernel.media.loaded) return null;
        if (kernel.media.type === 'video' && videoEl.readyState >= 2) return videoEl;
        if (kernel.media.type === 'image' && imageEl.complete && imageEl.naturalWidth > 0) return imageEl;
        if (kernel.media.type === 'stream') return streamCanvas;
        return null;
      }

      // Built-in procedural 2.39:1 CinemaScope stream renderer
      function renderStreamFrame(t) {
        const w = streamCanvas.width;
        const h = streamCanvas.height;
        const grad = streamCtx.createLinearGradient(0, 0, w, h);
        grad.addColorStop(0, '#071326');
        grad.addColorStop(0.5, '#132342');
        grad.addColorStop(1, '#26132b');
        streamCtx.fillStyle = grad;
        streamCtx.fillRect(0, 0, w, h);

        const cx = w * 0.5;
        const cy = h * 0.5;
        for (let i = 0; i < 12; i++) {
          const angle = (i / 12) * Math.PI * 2 + t * 0.45;
          const len = 140 + Math.sin(t * 1.4 + i) * 32;
          streamCtx.save();
          streamCtx.translate(cx, cy);
          streamCtx.rotate(angle);
          const rayGrad = streamCtx.createLinearGradient(0, 0, len, 0);
          rayGrad.addColorStop(0, 'rgba(251, 191, 36, 0.55)');
          rayGrad.addColorStop(1, 'rgba(56, 189, 248, 0.0)');
          streamCtx.strokeStyle = rayGrad;
          streamCtx.lineWidth = 2.2;
          streamCtx.beginPath();
          streamCtx.moveTo(0, 0);
          streamCtx.lineTo(len, 0);
          streamCtx.stroke();
          streamCtx.restore();
        }

        const flareX = cx + Math.sin(t * 0.8) * (w * 0.22);
        const flareGrad = streamCtx.createRadialGradient(flareX, cy, 4, flareX, cy, 240);
        flareGrad.addColorStop(0, 'rgba(254, 240, 138, 0.45)');
        flareGrad.addColorStop(0.45, 'rgba(56, 189, 248, 0.16)');
        flareGrad.addColorStop(1, 'rgba(56, 189, 248, 0)');
        streamCtx.fillStyle = flareGrad;
        streamCtx.fillRect(0, 0, w, h);

        streamCtx.fillStyle = 'rgba(241, 245, 249, 0.78)';
        streamCtx.font = '600 13px ui-monospace, SFMono-Regular, Menlo, monospace';
        streamCtx.fillText(`FRACTALOS // 2.39:1 ANAMORPHIC STREAM   T+${t.toFixed(1)}s`, 20, 26);
      }

      // Natural Liquid 8K upscaling pass onto high-res 2.39:1 canvas
      function renderLiquid8kPass(t) {
        if (!kernel.liquid8kEnabled || !kernel.media.loaded) return;

        const targetW = Math.min(2560, Math.max(1280, Math.round((window.innerWidth || 1280) * 1.5)));
        const targetH = Math.max(536, Math.round(targetW / 2.39));
        if (liquid8kCanvas.width !== targetW || liquid8kCanvas.height !== targetH) {
          liquid8kCanvas.width = targetW;
          liquid8kCanvas.height = targetH;
        }

        const source = getActiveMediaSource();
        if (!source) return;

        liquid8kCtx.save();
        liquid8kCtx.imageSmoothingEnabled = true;
        liquid8kCtx.imageSmoothingQuality = 'high';
        liquid8kCtx.drawImage(source, 0, 0, targetW, targetH);

        liquid8kCtx.save();
        liquid8kCtx.globalAlpha = 0.28;
        const shiftX = Math.sin(t * 1.8) * 2;
        const shiftY = Math.cos(t * 1.4) * 1;
        liquid8kCtx.drawImage(prevFrameCanvas, shiftX, shiftY, targetW, targetH);
        liquid8kCtx.restore();

        liquid8kCtx.save();
        liquid8kCtx.globalCompositeOperation = 'soft-light';
        liquid8kCtx.globalAlpha = 0.18;
        liquid8kCtx.drawImage(source, -1, 0, targetW + 2, targetH);
        liquid8kCtx.restore();
        liquid8kCtx.restore();

        prevFrameCtx.clearRect(0, 0, prevFrameCanvas.width, prevFrameCanvas.height);
        prevFrameCtx.drawImage(liquid8kCanvas, 0, 0, prevFrameCanvas.width, prevFrameCanvas.height);
      }

      // -----------------------------------------------------------------------
      // 4. 3D MULTIPLIED CONE SYSTEM (ORIGIN 0,0,0) & MOVIE BACKGROUND SCENE
      // -----------------------------------------------------------------------
      function resizeBgCanvas() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const w = Math.max(1, window.innerWidth || 1280);
        const h = Math.max(1, window.innerHeight || 720);
        if (bgCanvas.width !== Math.round(w * dpr) || bgCanvas.height !== Math.round(h * dpr)) {
          bgCanvas.width = Math.round(w * dpr);
          bgCanvas.height = Math.round(h * dpr);
        }
        return { dpr, w, h };
      }

      // Project 3D point (x,y,z) around origin (0,0,0) to 2D viewport coordinates
      function project3D(x, y, z, cx, cy, focal) {
        const cosY = Math.cos(kernel.cones.yaw);
        const sinY = Math.sin(kernel.cones.yaw);
        const x1 = x * cosY - z * sinY;
        const z1 = x * sinY + z * cosY;

        const cosP = Math.cos(kernel.cones.pitch);
        const sinP = Math.sin(kernel.cones.pitch);
        const y2 = y * cosP - z1 * sinP;
        const z2 = y * sinP + z1 * cosP;

        const depth = Math.max(120, focal + z2);
        const scale = (focal / depth) * kernel.cones.zoom;
        return {
          sx: cx + kernel.cones.panX + x1 * scale,
          sy: cy + kernel.cones.panY - y2 * scale,
          scale,
          z: z2,
        };
      }

      function renderBackgroundScene(dt) {
        const { dpr, w, h } = resizeBgCanvas();
        const is3d = kernel.viewMode === '3d';
        bgCtx.save();
        bgCtx.scale(dpr, dpr);

        bgCtx.fillStyle = kernel.theatreView ? '#05040a' : '#040711';
        bgCtx.fillRect(0, 0, w, h);

        const dir = kernel.streamMode === 'subtract' ? -1 : 1;
        kernel.cones.phase += dt * (is3d ? 0.95 : 0.65) * dir;
        if (!is3d && !isPointerOrbiting) {
          kernel.cones.yaw += dt * 0.14;
        }

        const cx = w * 0.5;
        const cy = h * (is3d ? 0.52 : 0.54);
        const focal = Math.min(w, h) * 0.95;
        const baseRadius = Math.min(w, h) * (is3d ? 0.34 : 0.25) * kernel.cones.scale;
        const spreadRad = (kernel.cones.spreadDeg * Math.PI) / 180;

        // 3D origin axes & reference rings in 3D Mode
        if (is3d) {
          const originPt = project3D(0, 0, 0, cx, cy, focal);
          const xAxisEnd = project3D(baseRadius * 1.15, 0, 0, cx, cy, focal);
          const yAxisEnd = project3D(0, baseRadius * 0.95, 0, cx, cy, focal);
          const zAxisEnd = project3D(0, 0, baseRadius * 1.15, cx, cy, focal);

          bgCtx.lineWidth = 1.25;
          // X axis (amber)
          bgCtx.strokeStyle = 'rgba(251, 191, 36, 0.38)';
          bgCtx.beginPath();
          bgCtx.moveTo(originPt.sx, originPt.sy);
          bgCtx.lineTo(xAxisEnd.sx, xAxisEnd.sy);
          bgCtx.stroke();
          // Y axis (emerald)
          bgCtx.strokeStyle = 'rgba(52, 211, 153, 0.38)';
          bgCtx.beginPath();
          bgCtx.moveTo(originPt.sx, originPt.sy);
          bgCtx.lineTo(yAxisEnd.sx, yAxisEnd.sy);
          bgCtx.stroke();
          // Z axis (cyan)
          bgCtx.strokeStyle = 'rgba(56, 189, 248, 0.38)';
          bgCtx.beginPath();
          bgCtx.moveTo(originPt.sx, originPt.sy);
          bgCtx.lineTo(zAxisEnd.sx, zAxisEnd.sy);
          bgCtx.stroke();

          // Origin equatorial ring
          bgCtx.strokeStyle = 'rgba(148, 184, 224, 0.14)';
          bgCtx.lineWidth = 1;
          bgCtx.beginPath();
          const ringSegs = 48;
          for (let s = 0; s <= ringSegs; s++) {
            const a = (s / ringSegs) * Math.PI * 2;
            const p = project3D(Math.cos(a) * baseRadius * 0.85, 0, Math.sin(a) * baseRadius * 0.85, cx, cy, focal);
            if (s === 0) bgCtx.moveTo(p.sx, p.sy);
            else bgCtx.lineTo(p.sx, p.sy);
          }
          bgCtx.stroke();
        }

        // Multiplied 3D cones anchored at origin (0,0,0)
        const n = kernel.cones.count;
        const coneItems = [];
        for (let i = 0; i < n; i++) {
          const theta = (i / n) * Math.PI * 2 + kernel.cones.phase;
          const elev = Math.sin(theta * 2 + kernel.cones.phase * 0.7) * (is3d ? 0.42 : 0.16);
          const pulse = 0.86 + 0.18 * Math.sin(kernel.cones.phase * 2.2 + i);
          const coneLen = baseRadius * pulse;
          const halfAngle = Math.max(0.09, spreadRad * 0.25);

          const tip = project3D(0, 0, 0, cx, cy, focal);
          const rimLeft = project3D(
            Math.cos(theta - halfAngle) * Math.cos(elev) * coneLen,
            Math.sin(elev) * coneLen,
            Math.sin(theta - halfAngle) * Math.cos(elev) * coneLen,
            cx, cy, focal
          );
          const rimRight = project3D(
            Math.cos(theta + halfAngle) * Math.cos(elev) * coneLen,
            Math.sin(elev) * coneLen,
            Math.sin(theta + halfAngle) * Math.cos(elev) * coneLen,
            cx, cy, focal
          );

          coneItems.push({
            index: i,
            tip,
            rimLeft,
            rimRight,
            avgZ: (tip.z + rimLeft.z + rimRight.z) / 3,
          });
        }

        // Painter's depth sort so front cones layer cleanly
        coneItems.sort(function (a, b) { return b.avgZ - a.avgZ; });

        for (let k = 0; k < coneItems.length; k++) {
          const item = coneItems[k];
          const i = item.index;
          bgCtx.beginPath();
          bgCtx.moveTo(item.tip.sx, item.tip.sy);
          bgCtx.lineTo(item.rimLeft.sx, item.rimLeft.sy);
          bgCtx.lineTo(item.rimRight.sx, item.rimRight.sy);
          bgCtx.closePath();

          const alphaBoost = is3d ? 1.35 : 0.85;
          if (kernel.streamMode === 'subtract') {
            bgCtx.fillStyle = i % 2 === 0
              ? `rgba(192, 132, 252, ${(0.11 * alphaBoost).toFixed(3)})`
              : `rgba(56, 189, 248, ${(0.08 * alphaBoost).toFixed(3)})`;
            bgCtx.strokeStyle = i % 2 === 0 ? 'rgba(192, 132, 252, 0.42)' : 'rgba(56, 189, 248, 0.28)';
          } else {
            bgCtx.fillStyle = i % 2 === 0
              ? `rgba(251, 191, 36, ${(0.10 * alphaBoost).toFixed(3)})`
              : `rgba(56, 189, 248, ${(0.09 * alphaBoost).toFixed(3)})`;
            bgCtx.strokeStyle = i % 2 === 0 ? 'rgba(251, 191, 36, 0.36)' : 'rgba(56, 189, 248, 0.28)';
          }
          bgCtx.fill();
          bgCtx.lineWidth = is3d ? 1.35 : 1.05;
          bgCtx.stroke();
        }

        // In 3D Mode, project active media/stream onto a 3D 2.39:1 CinemaScope screen plane
        const activeMedia = getActiveMediaSource();
        if (is3d && activeMedia) {
          const screenW = Math.min(w * 0.44, 440) * kernel.cones.zoom;
          const screenH = screenW / (kernel.squeeze239 ? 2.39 : 1.85);
          const zScreen = -baseRadius * 0.65;
          const tl = project3D(-screenW * 0.5, screenH * 0.5, zScreen, cx, cy, focal);
          const tr = project3D(screenW * 0.5, screenH * 0.5, zScreen, cx, cy, focal);
          const br = project3D(screenW * 0.5, -screenH * 0.5, zScreen, cx, cy, focal);
          const bl = project3D(-screenW * 0.5, -screenH * 0.5, zScreen, cx, cy, focal);

          const minX = Math.min(tl.sx, tr.sx, br.sx, bl.sx);
          const maxX = Math.max(tl.sx, tr.sx, br.sx, bl.sx);
          const minY = Math.min(tl.sy, tr.sy, br.sy, bl.sy);
          const maxY = Math.max(tl.sy, tr.sy, br.sy, bl.sy);
          const boxW = Math.max(40, maxX - minX);
          const boxH = Math.max(24, maxY - minY);

          bgCtx.save();
          bgCtx.beginPath();
          bgCtx.roundRect(minX, minY, boxW, boxH, 10);
          bgCtx.clip();
          if (kernel.streamMode === 'subtract') {
            bgCtx.filter = 'contrast(1.22) saturate(1.15) hue-rotate(-14deg)';
          }
          bgCtx.drawImage(activeMedia, minX, minY, boxW, boxH);
          bgCtx.restore();

          bgCtx.strokeStyle = 'rgba(251, 191, 36, 0.55)';
          bgCtx.lineWidth = 1.4;
          bgCtx.beginPath();
          bgCtx.roundRect(minX, minY, boxW, boxH, 10);
          bgCtx.stroke();
        }

        // Origin (0,0,0) core beacon
        const originCore = project3D(0, 0, 0, cx, cy, focal);
        bgCtx.beginPath();
        bgCtx.arc(originCore.sx, originCore.sy, is3d ? 7.5 : 5.5, 0, Math.PI * 2);
        bgCtx.fillStyle = kernel.streamMode === 'subtract' ? '#c084fc' : '#fbbf24';
        bgCtx.fill();

        // Compact 3D telemetry caption in top-left of 3D view
        if (is3d) {
          bgCtx.fillStyle = 'rgba(226, 232, 240, 0.82)';
          bgCtx.font = '600 11px ui-monospace, SFMono-Regular, Menlo, monospace';
          bgCtx.fillText(
            `3D ORIGIN (0,0,0) • N=${kernel.cones.count} • ${kernel.modeId} • ΔT ${(kernel.tOut - kernel.tIn).toFixed(1)}°C`,
            14,
            64
          );
        }

        bgCtx.restore();
      }

      // Interactive 3D Orbit / Zoom / Pan on background canvas when in 3D Mode
      let isPointerOrbiting = false;
      let isPointerPanning = false;
      let lastPtrX = 0;
      let lastPtrY = 0;

      bgCanvas.addEventListener('pointerdown', function (e) {
        if (kernel.viewMode !== '3d') return;
        isPointerOrbiting = e.button !== 2 && !e.shiftKey;
        isPointerPanning = e.button === 2 || e.shiftKey;
        lastPtrX = e.clientX;
        lastPtrY = e.clientY;
        try { bgCanvas.setPointerCapture(e.pointerId); } catch (_) {}
      });

      bgCanvas.addEventListener('pointermove', function (e) {
        if (kernel.viewMode !== '3d' || (!isPointerOrbiting && !isPointerPanning)) return;
        const dx = e.clientX - lastPtrX;
        const dy = e.clientY - lastPtrY;
        lastPtrX = e.clientX;
        lastPtrY = e.clientY;
        if (isPointerOrbiting) {
          kernel.cones.yaw += dx * 0.008;
          kernel.cones.pitch = Math.max(-1.25, Math.min(1.25, kernel.cones.pitch + dy * 0.008));
        } else if (isPointerPanning) {
          kernel.cones.panX += dx;
          kernel.cones.panY += dy;
        }
      });

      function endPointerDrag(e) {
        isPointerOrbiting = false;
        isPointerPanning = false;
        if (e && e.pointerId !== undefined) {
          try { bgCanvas.releasePointerCapture(e.pointerId); } catch (_) {}
        }
      }
      bgCanvas.addEventListener('pointerup', endPointerDrag);
      bgCanvas.addEventListener('pointercancel', endPointerDrag);
      bgCanvas.addEventListener('contextmenu', function (e) {
        if (kernel.viewMode === '3d') e.preventDefault();
      });
      bgCanvas.addEventListener('wheel', function (e) {
        if (kernel.viewMode !== '3d') return;
        e.preventDefault();
        const factor = e.deltaY > 0 ? 0.92 : 1.08;
        kernel.cones.zoom = Math.max(0.45, Math.min(2.6, kernel.cones.zoom * factor));
      }, { passive: false });

      // -----------------------------------------------------------------------
      // 5. EVENT LISTENERS, KEYBOARD SHORTCUTS & SELF-HEALING LOOP
      // -----------------------------------------------------------------------
      function bindEvents() {
        const fileInput = document.getElementById('mediaFileInput');
        const openPicker = function () {
          if (fileInput) fileInput.click();
        };

        document.getElementById('loadTopBtn').addEventListener('click', openPicker);
        document.getElementById('pickFileBtn').addEventListener('click', openPicker);
        document.getElementById('changeFileBtn').addEventListener('click', openPicker);
        document.getElementById('launchStreamBtn').addEventListener('click', launchBuiltInStream);

        document.getElementById('movieModeTopBtn').addEventListener('click', function () {
          setViewMode('movie', true);
        });
        document.getElementById('threeDModeTopBtn').addEventListener('click', function () {
          setViewMode('3d', true);
        });
        document.getElementById('viewModeCycleBtn').addEventListener('click', function () {
          setViewMode(kernel.viewMode === 'movie' ? '3d' : 'movie', true);
        });

        fileInput.addEventListener('change', function (e) {
          const file = e.target.files && e.target.files[0];
          if (file) loadUserFile(file);
          e.target.value = '';
        });

        const dropCard = document.getElementById('dropCard');
        window.addEventListener('dragover', function (e) {
          e.preventDefault();
          if (dropCard) dropCard.classList.add('drag-over');
        });
        window.addEventListener('dragleave', function (e) {
          if (!e.relatedTarget && dropCard) dropCard.classList.remove('drag-over');
        });
        window.addEventListener('drop', function (e) {
          e.preventDefault();
          if (dropCard) dropCard.classList.remove('drag-over');
          const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
          if (file) {
            loadUserFile(file);
          }
        });

        const togglePlayPause = function () {
          if (!kernel.media.loaded || kernel.media.type === 'image') return;
          if (kernel.media.type === 'stream') {
            kernel.media.playing = !kernel.media.playing;
            syncPlaybackUi();
            FractalBrain.emit(kernel.media.playing ? 'PLAYBACK_RESUMED' : 'PLAYBACK_PAUSED', {});
            return;
          }
          if (videoEl.paused) {
            videoEl.play().then(function () {
              kernel.media.playing = true;
              syncPlaybackUi();
              FractalBrain.emit('PLAYBACK_RESUMED', {});
            }).catch(function () {
              showToast('Tap again to play video');
            });
          } else {
            videoEl.pause();
            kernel.media.playing = false;
            syncPlaybackUi();
            FractalBrain.emit('PLAYBACK_PAUSED', {});
          }
        };

        document.getElementById('playPauseBtn').addEventListener('click', togglePlayPause);

        document.getElementById('muteBtn').addEventListener('click', function () {
          kernel.media.muted = !kernel.media.muted;
          videoEl.muted = kernel.media.muted;
          syncPlaybackUi();
          FractalBrain.emit('AUDIO_MUTE_CHANGED', { muted: kernel.media.muted });
        });

        document.getElementById('squeezeBtn').addEventListener('click', function () {
          kernel.squeeze239 = !kernel.squeeze239;
          syncMediaTransform();
          FractalBrain.emit('SQUEEZE_CHANGED', { squeeze239: kernel.squeeze239 });
        });

        document.getElementById('streamSubtractBtn').addEventListener('click', function () {
          kernel.streamMode = kernel.streamMode === 'stream' ? 'subtract' : 'stream';
          syncModeUi();
          showToast(kernel.streamMode === 'subtract' ? 'Subtract optical mode active' : 'Stream projection mode active');
          FractalBrain.emit('STREAM_MODE_CHANGED', { streamMode: kernel.streamMode });
        });

        document.getElementById('liquid8kBtn').addEventListener('click', function () {
          kernel.liquid8kEnabled = !kernel.liquid8kEnabled;
          syncLiquid8kUi();
          renderLiquid8kPass(kernel.elapsed);
          showToast(kernel.liquid8kEnabled ? 'Liquid 8K upscaling ON' : 'Liquid 8K upscaling OFF');
          FractalBrain.emit('LIQUID_8K_CHANGED', { enabled: kernel.liquid8kEnabled });
        });

        const toggleTheatre = function () {
          kernel.theatreView = !kernel.theatreView;
          syncTheatreUi();
          showToast(kernel.theatreView ? 'Theatre View ON' : 'Theatre View OFF');
          FractalBrain.emit('THEATRE_VIEW_CHANGED', { theatreView: kernel.theatreView });
        };
        document.getElementById('theatreTopBtn').addEventListener('click', toggleTheatre);
        document.getElementById('theatrePillBtn').addEventListener('click', toggleTheatre);

        document.getElementById('scopeTopBtn').addEventListener('click', function () {
          kernel.scopeEnabled = !kernel.scopeEnabled;
          syncScopeMattes();
          FractalBrain.emit('SCOPE_MATTES_CHANGED', { scopeEnabled: kernel.scopeEnabled });
        });

        window.addEventListener('keydown', function (e) {
          const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';
          if (tag === 'input' || tag === 'textarea' || e.metaKey || e.ctrlKey || e.altKey) return;
          if (e.key === '1' || e.key.toLowerCase() === 'm') {
            setViewMode('movie', true);
          } else if (e.key === '2' || e.key === '3') {
            setViewMode('3d', true);
          } else if (e.code === 'Space') {
            e.preventDefault();
            togglePlayPause();
          }
        });

        window.addEventListener('resize', function () {
          syncScopeMattes();
          renderBackgroundScene(0);
          renderLiquid8kPass(kernel.elapsed);
        });
      }

      let telemetryAccum = 0;

      function tickFrame(now) {
        const rawDt = (now - kernel.lastFrameTime) / 1000;
        kernel.lastFrameTime = now;
        const dt = Math.max(0.001, Math.min(rawDt, 0.05));

        kernel.elapsed += dt;
        kernel.frameCount += 1;
        kernel.lastRenderTick = performance.now();

        const targetFlow = (kernel.pwm / 100) * 7.2;
        kernel.flow += (targetFlow - kernel.flow) * Math.min(1, dt * 3);
        kernel.tOut += (((kernel.flux * 0.032) + kernel.tIn) - kernel.tOut) * Math.min(1, dt * 0.4);

        renderBackgroundScene(dt);

        if (kernel.media.loaded) {
          if (kernel.media.type === 'stream' && kernel.media.playing) {
            renderStreamFrame(kernel.elapsed);
          }
          if (kernel.liquid8kEnabled && kernel.viewMode === 'movie') {
            renderLiquid8kPass(kernel.elapsed);
          }
        }

        telemetryAccum += dt;
        if (telemetryAccum >= 0.35) {
          telemetryAccum = 0;
          const snap = snapshotBrainState();
          for (const app of fusedRegistry.values()) {
            if (app.onTelemetry) {
              try { app.onTelemetry(snap); } catch (_) {}
            }
          }
        }

        window.requestAnimationFrame(tickFrame);
      }

      // Immediate first-frame render & UI initialization
      syncViewModeUi();
      syncModeUi();
      syncLiquid8kUi();
      syncTheatreUi();
      syncScopeMattes();
      syncMediaTransform();
      syncPlaybackUi();
      updateBrainBadge();
      bindEvents();

      renderBackgroundScene(0.016);
      kernel.lastRenderTick = performance.now();

      // Self-healing startup watchdog: guarantees rendering even if rAF is throttled
      setInterval(function () {
        const sinceLast = performance.now() - kernel.lastRenderTick;
        if (sinceLast > 1200) {
          renderBackgroundScene(0.05);
          if (kernel.media.loaded && kernel.media.type === 'stream') {
            renderStreamFrame(kernel.elapsed);
          }
          if (kernel.media.loaded && kernel.liquid8kEnabled && kernel.viewMode === 'movie') {
            renderLiquid8kPass(kernel.elapsed);
          }
          kernel.lastRenderTick = performance.now();
        }
      }, 600);

      window.requestAnimationFrame(tickFrame);
    })();
  </script>
</body>
