      // -----------------------------------------------------------------------
      // 3. 2.39:1 CINEMASCOPE MEDIA, 3D / MOVIE MODES, LIQUID 8K & THEATRE
      // -----------------------------------------------------------------------
      const bgCanvas = document.getElementById('kernel-bg-canvas');
