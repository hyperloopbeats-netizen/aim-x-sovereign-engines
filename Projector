<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>FractalOS // 2.39:1 CinemaScope &amp; Sovereign Brain Kernel</title>
  <style>
    :root {
      --topbar-h: 44px;
      --matte-h: 0px;
      --bg-void: #040711;
      --bg-panel: rgba(9, 15, 29, 0.84);
      --border-subtle: rgba(148, 184, 224, 0.2);
      --accent-gold: #fbbf24;
      --accent-cyan: #38bdf8;
      --accent-violet: #c084fc;
      --accent-emerald: #34d399;
      --accent-rose: #fb7185;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--bg-void);
      color: var(--text-main);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-variant-numeric: tabular-nums;
    }

    /* Full-viewport animated background & multiplied cone telemetry canvas */
    #kernel-bg-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      display: block;
      transition: opacity 0.28s ease, filter 0.28s ease;
    }

    body.view-3d #kernel-bg-canvas {
      z-index: 6;
      cursor: grab;
      touch-action: none;
    }
    body.view-3d #kernel-bg-canvas:active {
      cursor: grabbing;
    }

    /* Theatre View auditorium surround & curtain framing */
    #theatre-surround {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 4;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s ease;
      background:
        radial-gradient(ellipse 80% 52% at 50% 48%, rgba(251, 191, 36, 0.11) 0%, rgba(8, 12, 24, 0.55) 62%, rgba(2, 4, 10, 0.94) 100%),
        linear-gradient(to top, rgba(4, 6, 12, 0.96) 0%, rgba(36, 10, 18, 0.62) 22%, transparent 46%),
        linear-gradient(to right, rgba(34, 8, 16, 0.78) 0%, transparent 16%, transparent 84%, rgba(34, 8, 16, 0.78) 100%);
    }
    body.theatre-on #theatre-surround {
      opacity: 1;
    }

    #curtain-left, #curtain-right {
      position: fixed;
      top: var(--topbar-h);
      bottom: 0;
      width: 0vw;
      z-index: 6;
      pointer-events: none;
      background: linear-gradient(90deg, rgba(32, 7, 15, 0.92) 0%, rgba(72, 14, 28, 0.74) 68%, rgba(130, 28, 48, 0.14) 100%);
      border-right: 1px solid rgba(251, 191, 36, 0.22);
      transition: width 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    }
    #curtain-left { left: 0; }
    #curtain-right { right: 0; transform: scaleX(-1); }
    body.theatre-on #curtain-left,
    body.theatre-on #curtain-right {
      width: min(7vw, 72px);
    }

    /* 2.39:1 CinemaScope Projection Stage */
    #scope-stage {
      position: fixed;
      top: calc(var(--topbar-h) + var(--matte-h));
      bottom: var(--matte-h);
      left: 0;
      right: 0;
      z-index: 5;
      display: none;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      overflow: hidden;
      background: rgba(3, 6, 14, 0.88);
      transition: top 0.25s ease, bottom 0.25s ease, box-shadow 0.3s ease, opacity 0.25s ease;
    }
    body.has-media.view-movie #scope-stage {
      display: flex;
    }
    body.view-3d #scope-stage {
      display: none;
    }
    body.theatre-on #scope-stage {
      box-shadow: 0 0 80px rgba(251, 191, 36, 0.14), inset 0 0 50px rgba(0, 0, 0, 0.72);
    }

    /* In 3D mode, keep the centered load prompt accessible when no media is loaded yet */
    body.has-media.view-3d #load-prompt-layer {
      display: none;
    }

    #scope-media-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      transition: transform 0.22s ease, filter 0.25s ease;
    }

    /* Subtract optical mode: carves an anamorphic center-subtracted aperture */
    body.mode-subtract #scope-media-wrap {
      filter: contrast(1.24) saturate(1.18) hue-rotate(-14deg);
      -webkit-mask-image:
        radial-gradient(ellipse 44% 82% at 50% 50%, rgba(0,0,0,0.06) 0%, rgba(0,0,0,0.14) 48%, rgba(0,0,0,0.92) 72%, #000000 100%),
        linear-gradient(to right, #000000 0%, rgba(0,0,0,0.4) 14%, rgba(0,0,0,0.12) 30%, rgba(0,0,0,0.12) 70%, rgba(0,0,0,0.4) 86%, #000000 100%);
      -webkit-mask-composite: source-over;
      mask-image:
        radial-gradient(ellipse 44% 82% at 50% 50%, rgba(0,0,0,0.06) 0%, rgba(0,0,0,0.14) 48%, rgba(0,0,0,0.92) 72%, #000000 100%),
        linear-gradient(to right, #000000 0%, rgba(0,0,0,0.4) 14%, rgba(0,0,0,0.12) 30%, rgba(0,0,0,0.12) 70%, rgba(0,0,0,0.4) 86%, #000000 100%);
    }

    #scope-video,
    #scope-image,
    #scope-stream-canvas,
    #scope-liquid8k-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.22s ease, opacity 0.2s ease;
    }

    #scope-video,
    #scope-image,
    #scope-stream-canvas {
      display: none;
    }

    #scope-liquid8k-canvas {
      display: none;
      image-rendering: auto;
      filter: contrast(1.05) saturate(1.06);
    }

    body.liquid8k-on #scope-liquid8k-canvas {
      display: block;
      z-index: 3;
    }

    /* Subtle CinemaScope optical reticle & aspect badge inside stage */
    #scope-reticle {
      position: absolute;
      inset: 0;
      z-index: 4;
      pointer-events: none;
      border-top: 1px solid rgba(251, 191, 36, 0.22);
      border-bottom: 1px solid rgba(251, 191, 36, 0.22);
    }
    body.mode-subtract #scope-reticle {
      border-color: rgba(192, 132, 252, 0.42);
      box-shadow: inset 0 0 64px rgba(15, 23, 42, 0.85);
    }

    /* Top & Bottom 2.39:1 CinemaScope Mattes */
    #scope-matte-top,
    #scope-matte-bottom {
      position: fixed;
      left: 0;
      right: 0;
      height: var(--matte-h);
      background: #020307;
      z-index: 7;
      pointer-events: none;
      opacity: 0;
      transition: height 0.25s ease, opacity 0.25s ease;
    }
    #scope-matte-top {
      top: var(--topbar-h);
      border-bottom: 1px solid rgba(251, 191, 36, 0.16);
    }
    #scope-matte-bottom {
      bottom: 0;
      border-top: 1px solid rgba(251, 191, 36, 0.16);
    }
    body.scope-on #scope-matte-top,
    body.scope-on #scope-matte-bottom {
      opacity: 0.97;
    }

    /* Slim Top Bar */
    #top-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      z-index: 30;
      padding: 0 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      background: rgba(6, 10, 20, 0.86);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
    }

    .top-left, .top-right {
      display: flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
    }

    .brand-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--accent-gold);
      box-shadow: 0 0 10px rgba(251, 191, 36, 0.8);
      flex-shrink: 0;
    }

    .brand-title {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: #ffffff;
      white-space: nowrap;
    }

    .brain-pill {
      padding: 3px 8px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 600;
      color: #e9d5ff;
      background: rgba(168, 85, 247, 0.16);
      border: 1px solid rgba(192, 132, 252, 0.36);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 170px;
    }

    .top-btn {
      padding: 4px 9px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid var(--border-subtle);
      background: rgba(15, 23, 42, 0.78);
      color: var(--text-main);
      transition: background 0.16s ease, border-color 0.16s ease, transform 0.1s ease;
      white-space: nowrap;
    }
    .top-btn:active {
      transform: scale(0.97);
    }
    .top-btn.active-cyan {
      background: rgba(56, 189, 248, 0.22);
      border-color: rgba(56, 189, 248, 0.62);
      color: #e0f2fe;
    }
    .top-btn.active-rose {
      background: rgba(244, 63, 94, 0.24);
      border-color: rgba(251, 113, 133, 0.65);
      color: #fecdd3;
    }
    .top-btn.load-btn {
      background: rgba(56, 189, 248, 0.2);
      border-color: rgba(56, 189, 248, 0.55);
      color: #e0f2fe;
    }

    /* Centered Clean Prompt to Load/Drop MP4 or Start Stream */
    #load-prompt-layer {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      pointer-events: none;
    }
    body.has-media #load-prompt-layer {
      display: none;
    }

    .prompt-card {
      pointer-events: auto;
      width: 100%;
      max-width: 420px;
      padding: 24px 20px;
      border-radius: 20px;
      text-align: center;
      background: var(--bg-panel);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      border: 1px solid rgba(251, 191, 36, 0.32);
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.72), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .prompt-card.drag-over {
      border-color: var(--accent-cyan);
      transform: scale(1.015);
    }

    .prompt-kicker {
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent-gold);
      margin-bottom: 8px;
    }

    .prompt-title {
      margin: 0 0 8px 0;
      font-size: 19px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.25;
    }

    .prompt-desc {
      margin: 0 0 18px 0;
      font-size: 12px;
      line-height: 1.5;
      color: var(--text-muted);
    }

    .prompt-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .action-btn {
      padding: 10px 16px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.16s ease;
    }
    .action-btn:active {
      transform: scale(0.97);
    }
    .action-btn.primary {
      background: rgba(251, 191, 36, 0.24);
      border-color: rgba(251, 191, 36, 0.65);
      color: #fef9c3;
    }
    .action-btn.primary:hover {
      background: rgba(251, 191, 36, 0.34);
    }
    .action-btn.secondary {
      background: rgba(56, 189, 248, 0.18);
      border-color: rgba(56, 189, 248, 0.52);
      color: #e0f2fe;
    }
    .action-btn.secondary:hover {
      background: rgba(56, 189, 248, 0.28);
    }

    .prompt-hint {
      margin-top: 12px;
      font-size: 10px;
      color: #64748b;
    }

    /* Compact Non-Overlapping Control Pill Strip at Bottom */
    #control-pill {
      position: fixed;
      bottom: calc(var(--matte-h) + 10px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 25;
      display: none;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 6px;
      max-width: calc(100vw - 16px);
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(7, 12, 24, 0.88);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--border-subtle);
      box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65);
      transition: bottom 0.25s ease;
    }
    body.has-media #control-pill {
      display: flex;
    }

    .pill-btn {
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid rgba(148, 184, 224, 0.22);
      background: rgba(15, 23, 42, 0.75);
      color: var(--text-main);
      transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
      white-space: nowrap;
    }
    .pill-btn:active {
      transform: scale(0.96);
    }
    .pill-btn.on-amber {
      background: rgba(251, 191, 36, 0.22);
      border-color: rgba(251, 191, 36, 0.6);
      color: #fef08a;
    }
    .pill-btn.on-cyan {
      background: rgba(56, 189, 248, 0.22);
      border-color: rgba(56, 189, 248, 0.6);
      color: #e0f2fe;
    }
    .pill-btn.on-emerald {
      background: rgba(52, 211, 153, 0.22);
      border-color: rgba(52, 211, 153, 0.6);
      color: #d1fae5;
    }
    .pill-btn.on-violet {
      background: rgba(192, 132, 252, 0.24);
      border-color: rgba(192, 132, 252, 0.65);
      color: #f3e8ff;
    }
    .pill-btn.on-rose {
      background: rgba(251, 113, 133, 0.24);
      border-color: rgba(251, 113, 133, 0.65);
      color: #ffe4e6;
    }

    .pill-meta {
      font-size: 10px;
      color: var(--text-muted);
      max-width: 120px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      padding: 0 4px;
    }

    /* Subtle non-blocking toast / recovery banner */
    #status-toast {
      position: fixed;
      top: calc(var(--topbar-h) + 8px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 35;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 10px;
      color: #fef08a;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(251, 191, 36, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      max-width: 92vw;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #status-toast.show {
      opacity: 1;
    }

    @media (max-width: 640px) {
      .brain-pill {
        max-width: 108px;
      }
      .top-btn {
        padding: 4px 7px;
        font-size: 9.5px;
      }
      .pill-btn {
        padding: 5px 8px;
        font-size: 9.5px;
      }
      .pill-meta {
        max-width: 84px;
      }
    }
  </style>
</head>
<body class="scope-on mode-stream liquid8k-on">
  <!-- Full-viewport 2D Canvas: Origin (0,0) Multiplied Cone System + CSP Collector & Brain Telemetry -->
  <canvas id="kernel-bg-canvas" aria-label="FractalOS Multiplied Cone & CSP Telemetry Canvas"></canvas>

  <!-- Theatre View Auditorium Surround & Curtains -->
  <div id="theatre-surround" aria-hidden="true"></div>
  <div id="curtain-left" aria-hidden="true"></div>
  <div id="curtain-right" aria-hidden="true"></div>

  <!-- 2.39:1 CinemaScope Projection Stage -->
  <div id="scope-stage" aria-label="2.39:1 CinemaScope Stage">
    <div id="scope-media-wrap">
      <video id="scope-video" playsinline loop muted preload="auto"></video>
      <img id="scope-image" alt="Loaded CinemaScope Frame" />
      <canvas id="scope-stream-canvas" width="956" height="400"></canvas>
      <canvas id="scope-liquid8k-canvas" width="1920" height="804"></canvas>
      <div id="scope-reticle"></div>
    </div>
  </div>

  <!-- 2.39:1 CinemaScope Theatrical Mattes -->
  <div id="scope-matte-top" aria-hidden="true"></div>
  <div id="scope-matte-bottom" aria-hidden="true"></div>

  <!-- Slim Top Bar -->
  <header id="top-bar" class="mono">
    <div class="top-left">
      <span class="brand-dot"></span>
      <span class="brand-title">FractalOS</span>
      <span id="brainBadge" class="brain-pill">BRAIN v2.0 • 1 APP</span>
    </div>
    <div class="top-right">
      <button id="movieModeTopBtn" type="button" aria-pressed="true" class="top-btn active-gold">MOVIE</button>
      <button id="threeDModeTopBtn" type="button" aria-pressed="false" class="top-btn">3D MODE</button>
      <button id="theatreTopBtn" type="button" aria-pressed="false" class="top-btn">THEATRE: OFF</button>
      <button id="scopeTopBtn" type="button" aria-pressed="true" class="top-btn active-gold">2.39:1: ON</button>
      <button id="loadTopBtn" type="button" class="top-btn load-btn">LOAD FILE</button>
      <input id="mediaFileInput" type="file" accept="video/mp4,video/*,image/*" style="display:none;" />
    </div>
  </header>

  <!-- Non-blocking status toast -->
  <div id="status-toast" class="mono" role="status" aria-live="polite"></div>

  <!-- Centered Clean Prompt to Load/Drop MP4 or Image (or Launch Test Stream) -->
  <main id="load-prompt-layer">
    <div id="dropCard" class="prompt-card">
      <div class="prompt-kicker mono">2.39:1 CinemaScope • 3D &amp; Movie Kernel v2.0</div>
      <h1 class="prompt-title">Add an MP4 or media file to project</h1>
      <p class="prompt-desc">
        Select or drop an <span class="mono" style="color:#fde68a;">.mp4</span> video or image onto the 2.39:1 CinemaScope stage, launch the built-in stream, or switch to <span class="mono" style="color:#7dd3fc;">3D Mode</span>.
      </p>
      <div class="prompt-actions">
        <button id="pickFileBtn" type="button" class="action-btn primary mono">Add MP4 / File</button>
        <button id="launchStreamBtn" type="button" class="action-btn secondary mono">Launch 2.39:1 Stream</button>
      </div>
      <div class="prompt-hint mono">Keys: [1/M] Movie • [2/3] 3D • [Space] Play/Pause • Drag &amp; drop MP4</div>
    </div>
  </main>

  <!-- Compact Bottom Control Pill -->
  <nav id="control-pill" class="mono" aria-label="CinemaScope & 3D Controls">
    <button id="viewModeCycleBtn" type="button" aria-pressed="false" class="pill-btn on-amber">Mode: Movie</button>
    <button id="playPauseBtn" type="button" class="pill-btn on-amber">Pause</button>
    <button id="muteBtn" type="button" class="pill-btn">Unmute</button>
    <button id="squeezeBtn" type="button" aria-pressed="true" class="pill-btn on-cyan">2.39x Squeeze: ON</button>
    <button id="streamSubtractBtn" type="button" aria-pressed="false" class="pill-btn on-emerald">Mode: Stream</button>
    <button id="liquid8kBtn" type="button" aria-pressed="true" class="pill-btn on-cyan">Liquid 8K: ON</button>
    <span id="mediaLabel" class="pill-meta">239_stream.mp4</span>
    <button id="changeFileBtn" type="button" class="pill-btn">Change</button>
  </nav>

  <script>
    (function () {
      'use strict';

      // -----------------------------------------------------------------------
      // 1. CORE KERNEL STATE, AIM-X SOVEREIGN TELEMETRY & WATCHDOG
      // -----------------------------------------------------------------------
      const kernel = {
        elapsed: 0,
        lastFrameTime: performance.now(),
        frameCount: 0,
        lastRenderTick: performance.now(),
        flux: 860,
        tOut: 69.5,
        tIn: 41.5,
        pwm: 64,
        flow: 4.6,
        pcmSoc: 0.25,
        modeId: 'M4',
        viewMode: 'movie', // 'movie' | '3d'
        streamMode: 'stream', // 'stream' | 'subtract'
        squeeze239: true,
        scopeEnabled: true,
        liquid8kEnabled: true,
        theatreView: false,
        aimx: {
          coreACoherence: 0.88,
          coreBImpulse: 0.64,
          swarmNodes: 18,
          zeroCrossingHz: 1.4,
          zeroCrossingPhase: 0,
          firstPrincipleResonance: 0.92,
          groundingStability: 0.97,
        },
        cones: {
          count: 12,
          scale: 1.0,
          spreadDeg: 34,
          phase: 0,
          yaw: 0.42,
          pitch: 0.34,
          zoom: 1.0,
          panX: 0,
          panY: 0,
        },
        media: {
          loaded: false,
          type: 'none', // 'none' | 'video' | 'image' | 'stream'
          playing: false,
          muted: true,
          name: '',
          objectUrl: '',
        },
      };

      function showToast(msg) {
        const el = document.getElementById('status-toast');
        if (!el) return;
        el.textContent = msg;
        el.classList.add('show');
        clearTimeout(showToast._timer);
        showToast._timer = setTimeout(function () { el.classList.remove('show'); }, 2600);
      }

      // -----------------------------------------------------------------------
      // 2. MAIN BRAIN BUS (window.FractalBrain v2.1.0 + AIM-X SOVEREIGN ENGINES)
      // -----------------------------------------------------------------------
      const fusedRegistry = new Map();
      const eventListeners = new Set();
      let eventSeq = 0;

      function snapshotBrainState() {
        const actualDt = Number(Math.max(0, kernel.tOut - kernel.tIn).toFixed(1));
        return {
          ts: Number(kernel.elapsed.toFixed(2)),
          modeId: kernel.modeId,
          viewMode: kernel.viewMode,
          flux: kernel.flux,
          actualDt,
          pwm: Number(kernel.pwm.toFixed(1)),
          flow: Number(kernel.flow.toFixed(2)),
          pcmSoc: Number(kernel.pcmSoc.toFixed(2)),
          streamMode: kernel.streamMode,
          squeeze239: kernel.squeeze239,
          scopeEnabled: kernel.scopeEnabled,
          liquid8kEnabled: kernel.liquid8kEnabled,
          theatreView: kernel.theatreView,
          playing: kernel.media.playing,
          mediaName: kernel.media.name || null,
          mediaType: kernel.media.type,
          aimx: {
            coreACoherence: Number(kernel.aimx.coreACoherence.toFixed(3)),
            coreBImpulse: Number(kernel.aimx.coreBImpulse.toFixed(3)),
            swarmNodes: kernel.aimx.swarmNodes,
            zeroCrossingHz: Number(kernel.aimx.zeroCrossingHz.toFixed(2)),
            firstPrincipleResonance: Number(kernel.aimx.firstPrincipleResonance.toFixed(3)),
            groundingStability: Number(kernel.aimx.groundingStability.toFixed(3)),
          },
          fusedAppIds: Array.from(fusedRegistry.keys()),
        };
      }

      const FractalBrain = {
        version: '2.1.0',
        get state() {
          return snapshotBrainState();
        },
        getSnapshot() {
          return snapshotBrainState();
        },
        get apps() {
          return Array.from(fusedRegistry.values());
        },
        get engines() {
          return Array.from(fusedRegistry.values());
        },
        registerApp(appSpec) {
          if (!appSpec || typeof appSpec.id !== 'string' || !appSpec.id.trim()) {
            return false;
          }
          const id = appSpec.id.trim();
          const record = {
            id,
            name: appSpec.name || id,
            fusedAt: Number(kernel.elapsed.toFixed(2)),
            onTelemetry: typeof appSpec.onTelemetry === 'function' ? appSpec.onTelemetry : null,
            onEvent: typeof appSpec.onEvent === 'function' ? appSpec.onEvent : null,
          };
          fusedRegistry.set(id, record);
          updateBrainBadge();
          this.emit('APP_REGISTERED', { id, name: record.name });
          return true;
        },
        fuseApp(appSpec) {
          const ok = this.registerApp(appSpec);
          if (ok) {
            this.emit('APP_FUSED', { id: appSpec.id, name: appSpec.name || appSpec.id });
          }
          return ok;
        },
        set(patch) {
          if (!patch || typeof patch !== 'object') return snapshotBrainState();
          const prevViewMode = kernel.viewMode;
          if (patch.viewMode === 'movie' || patch.viewMode === '3d') {
            setViewMode(patch.viewMode, false);
          }
          if (patch.streamMode === 'stream' || patch.streamMode === 'subtract') {
            setStreamMode(patch.streamMode, false);
          }
          if (typeof patch.squeeze239 === 'boolean') {
            kernel.squeeze239 = patch.squeeze239;
            syncMediaTransform();
          }
          if (typeof patch.scopeEnabled === 'boolean') {
            kernel.scopeEnabled = patch.scopeEnabled;
            syncScopeMattes();
          }
          if (typeof patch.liquid8kEnabled === 'boolean') {
            setLiquid8k(patch.liquid8kEnabled, false);
          }
          if (typeof patch.theatreView === 'boolean') {
            setTheatreView(patch.theatreView, false);
          }
          if (typeof patch.flux === 'number' && Number.isFinite(patch.flux)) {
            kernel.flux = Math.max(0, Math.min(1200, patch.flux));
          }
          if (typeof patch.modeId === 'string' && patch.modeId.trim()) {
            kernel.modeId = patch.modeId.trim();
          }
          updateBrainBadge();
          this.emit('STATE_UPDATED', { patch });
          if (prevViewMode !== kernel.viewMode) {
            this.emit('mode:changed', { viewMode: kernel.viewMode, previousViewMode: prevViewMode });
          }
          return snapshotBrainState();
        },
        setViewMode(nextMode) {
          setViewMode(nextMode, true);
          return snapshotBrainState();
        },
        setStreamMode(nextMode) {
          setStreamMode(nextMode, true);
          return snapshotBrainState();
        },
        setLiquid8k(enabled) {
          setLiquid8k(Boolean(enabled), true);
          return snapshotBrainState();
        },
        setTheatreView(enabled) {
          setTheatreView(Boolean(enabled), true);
          return snapshotBrainState();
        },
        emit(eventName, payload) {
          eventSeq += 1;
          const evt = {
            seq: eventSeq,
            version: '2.1.0',
            ts: Number(kernel.elapsed.toFixed(2)),
            type: String(eventName || 'EVENT'),
            payload: payload || {},
            state: snapshotBrainState(),
          };
          for (const fn of eventListeners) {
            try { fn(evt); } catch (_) {}
          }
          for (const app of fusedRegistry.values()) {
            if (app.onEvent) {
              try { app.onEvent(evt); } catch (_) {}
            }
          }
          return evt;
        },
        on(callback) {
          if (typeof callback !== 'function') return function () {};
          eventListeners.add(callback);
          return function unsubscribe() {
            eventListeners.delete(callback);
          };
        },
      };

      window.FractalBrain = FractalBrain;

      function updateBrainBadge() {
        const badge = document.getElementById('brainBadge');
